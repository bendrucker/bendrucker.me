{
  "name": "bendrucker.me",
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "spotlight run astro dev",
    "dev:json": "ASTRO_LOG_JSON=1 astro dev",
    "build": "npm run build:packages && npm run types:generate && astro check && astro build",
    "build:packages": "npm run build --workspace=packages/logger -- --force && npm run build --workspace=packages/github -- --force",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lighthouse": "lhci autorun",
    "types:generate": "wrangler types && prettier --write worker-configuration.d.ts",
    "test": "vitest run",
    "fetch-activity": "tsx scripts/fetch-github-activity.ts",
    "generate:favicons": "tsx scripts/generate-favicons.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.1",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vue": "7.0.1",
    "@cf-wasm/resvg": "^0.3.4",
    "@cf-wasm/satori": "^0.3.6",
    "@date-fns/tz": "^1.5.0",
    "@sentry/cloudflare": "^10.62.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.1.1",
    "astro": "7.1.3",
    "date-fns": "^4.4.0",
    "kysely": "^0.29.3",
    "lodash.kebabcase": "^4.1.1",
    "reka-ui": "^2.10.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "shiki": "^4.3.1",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/tailwind4": "^1.2.3",
    "@lhci/cli": "^0.15.1",
    "@sentry/astro": "^10.63.0",
    "@shikijs/transformers": "^4.3.1",
    "@spotlightjs/spotlight": "^4.11.7",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/opentype.js": "^1.3.10",
    "@typescript-eslint/parser": "^8.60.0",
    "better-sqlite3": "^12.11.1",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^2.1.1",
    "globals": "^17.7.0",
    "linguist-languages": "^9.4.0",
    "opentype.js": "^2.0.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "zod": "4.3.6",
    "qs": "6.15.0",
    "lodash": "4.17.23",
    "tmp": "0.2.5"
  }
}
