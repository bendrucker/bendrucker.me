---
import Socials from "./Socials.astro";
import { SITE } from "@/config";
import { creditLine, type Credit } from "@/categories";

const currentYear = new Date().getFullYear();

export interface Props {
  noMarginTop?: boolean;
  sourcePath?: string;
  /** What the page's own art needs credited. Each page names what it renders. */
  credits?: readonly Credit[];
}

const { noMarginTop = false, sourcePath, credits = [] } = Astro.props;
const sourceUrl = sourcePath
  ? `${SITE.viewSource.url}${sourcePath}`
  : undefined;
const credited = creditLine(credits);
---

<footer
  class:list={[
    "flex w-full flex-col gap-2.5 border-t border-line px-4 pt-3.5 pb-4.5 text-xs text-dim md:px-12 md:pt-4.5 md:pb-5.5",
    { "mt-auto": !noMarginTop },
  ]}
>
  {credited && <p class="text-[11px] leading-relaxed">{credited}</p>}
  <div class="flex items-center justify-between gap-3">
    <span>
      &#169; {currentYear} Ben Drucker
      {
        sourceUrl && (
          <>
            <span aria-hidden="true">&middot;</span>
            <a
              href={sourceUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-dim hover:text-foreground"
            >
              {SITE.viewSource.text}
            </a>
          </>
        )
      }
    </span>
    <Socials />
  </div>
</footer>
