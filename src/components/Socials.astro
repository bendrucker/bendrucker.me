---
import { SOCIALS } from "@/constants";

/** The footer's profiles, each with its Lucide mark written out for Tailwind. */
const ICONS: Record<string, string> = {
  GitHub: "icon-[lucide--github]",
  LinkedIn: "icon-[lucide--linkedin]",
  Mail: "icon-[lucide--mail]",
  RSS: "icon-[lucide--rss]",
};

const links = SOCIALS.flatMap((social) => {
  const icon = ICONS[social.name];
  return icon ? [{ ...social, icon }] : [];
});
---

<div class="-mr-2 flex items-center gap-0.5">
  {links.map((social) => (
    <a
      href={social.href}
      class="inline-flex size-8 items-center justify-center rounded-lg text-dim hover:bg-hover hover:text-foreground"
      title={social.linkTitle}
      aria-label={social.linkTitle}
      {...(social.href.startsWith("http") && {
        target: "_blank",
        rel: "noopener noreferrer",
      })}
    >
      <span aria-hidden="true" class:list={[social.icon, "size-[15px]"]} />
    </a>
  ))}
</div>
