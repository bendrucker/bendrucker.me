---
import { formatStat, type StatKind } from "@/home/format";
import type { ByPeriod, Period } from "@/home/stats";
import PeriodToggle from "./PeriodToggle.astro";

/**
 * The numbers across the top of a rail, one value per window, with the
 * window toggle standing where a caption would.
 */
export interface Stat {
  kind: StatKind;
  value: ByPeriod<number | null>;
  unit: string;
  /** Names the number for the accessibility tree, where the unit is not enough. */
  label?: string;
}

export interface Props {
  stats: Stat[];
  selected: Period;
}

const { stats, selected } = Astro.props;
---

<div class="border-b border-border py-3">
  <div class="mb-1.5">
    <PeriodToggle selected={selected} />
  </div>
  <dl class="flex flex-wrap items-baseline gap-x-5 gap-y-2">
    {
      stats.map((stat) => (
        <div class="flex items-baseline gap-1">
          <dt class="sr-only">{stat.label ?? stat.unit}</dt>
          <dd
            class="font-sans text-2xl leading-none font-extrabold tracking-tight tabular-nums"
            data-stat
            data-kind={stat.kind}
            data-values={JSON.stringify(stat.value)}
          >
            {formatStat(stat.value[selected], stat.kind)}
          </dd>
          <dd class="text-xs font-semibold text-foreground/70">{stat.unit}</dd>
        </div>
      ))
    }
  </dl>
</div>
