---
import RepoRow from "@/components/activity/RepoRow.vue";
import RideRow from "@/components/cycling/RideRow.vue";
import { SITE } from "@/config";
import { latelySentence } from "@/home/lately";
import { loadRecentActivity } from "@/home/load";
import Rail from "./Rail.astro";

/**
 * The week in a sentence, then the two rails side by side, rides above
 * repositories on a phone.
 */
const { rides, repos, week } = await loadRecentActivity();
---

<p class="page-column pt-2 text-base text-foreground/60">
  {latelySentence(week)}
</p>
<div
  class="page-column grid gap-x-8 gap-y-8 pt-6 pb-12 sm:grid-cols-2 sm:gap-x-10 sm:pt-8"
>
  <Rail label="Cycling" icon="bike" href="/activity/cycling" link="All rides">
    {
      rides.map((ride) => (
        <li>
          <RideRow ride={ride} />
        </li>
      ))
    }
  </Rail>
  <Rail label="Code" icon="code" href="/activity/code" link="All repos">
    {
      repos.map((repo) => (
        <li>
          <RepoRow repo={repo} username={SITE.githubUsername} />
        </li>
      ))
    }
  </Rail>
</div>
