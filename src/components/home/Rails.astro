---
import RepoRow from "@/components/activity/RepoRow.vue";
import RideRow from "@/components/cycling/RideRow.vue";
import { groupByRecency } from "@/components/recency";
import { SITE } from "@/config";
import { loadHome } from "@/home/load";
import { repoWhen, rideWhen, siteWallClock } from "@/home/recent";
import { PERIODS, periodLabel, type Period } from "@/home/stats";
import PeriodToggle from "./PeriodToggle.astro";
import Rail from "./Rail.astro";
import RailGroup from "./RailGroup.astro";
import StatBand from "./StatBand.astro";
import Ticker from "./Ticker.astro";

/**
 * The homepage's two rails side by side, or on a phone a track that snaps
 * one rail at a time, swiped or tapped into view through the tab row,
 * which sticks to the top while the rail scrolls. Each rail opens on its
 * totals over the period the toggle above selects, then the latest few
 * rows, and a ticker of lifetime records runs beneath both.
 *
 * The track scrolls without the script; the script keeps the tab row's
 * indicator under the rail in view, moving with a swipe and ahead of a
 * tap, and counts the totals to their new values when the period changes.
 */
const now = new Date();
const { rides, repos, cyclingTotals, codeTotals, ticker } = await loadHome(now);
const today = siteWallClock(now);
const rideGroups = groupByRecency(rides, rideWhen, today);
const repoGroups = groupByRecency(repos, repoWhen, today);

/** The middle distance: recent enough to move, long enough to add up. */
const selected: Period = "year";

const captions = Object.fromEntries(
  PERIODS.map((period) => [period, periodLabel(period, now)]),
) as Record<Period, string>;
const byPeriod = (pick: (period: Period) => number) =>
  Object.fromEntries(PERIODS.map((period) => [period, pick(period)])) as Record<
    Period,
    number
  >;

const cyclingStats = [
  {
    kind: "distance" as const,
    value: byPeriod((p) => cyclingTotals[p].distanceMi),
    unit: "mi",
    label: "distance",
  },
  {
    kind: "elevation" as const,
    value: byPeriod((p) => cyclingTotals[p].elevationFt),
    unit: "ft",
    label: "climbing",
  },
  {
    kind: "count" as const,
    value: byPeriod((p) => cyclingTotals[p].rideCount),
    unit: "rides",
  },
];

const codeStats = [
  { kind: "count" as const, value: codeTotals.prCount, unit: "PRs" },
  { kind: "count" as const, value: codeTotals.reviewCount, unit: "reviews" },
  { kind: "count" as const, value: codeTotals.repoCount, unit: "repos" },
];

const tab =
  "flex cursor-pointer items-center gap-1.5 pb-2 text-xs tracking-[0.14em] text-foreground/45 uppercase transition-colors aria-selected:text-foreground";
---

<div class="page-column pt-5 pb-10 sm:pt-6" data-rails>
  <div class="mb-4 sm:flex sm:justify-end">
    <PeriodToggle selected={selected} />
  </div>
  <div
    role="tablist"
    aria-label="Activity"
    class="sticky top-0 z-10 flex gap-6 border-b border-border bg-background pt-3 sm:hidden"
  >
    <button
      type="button"
      role="tab"
      id="tab-cycling"
      aria-controls="rail-cycling"
      aria-selected="true"
      class={tab}
    >
      <span class="icon-[lucide--bike] size-3.5" aria-hidden="true"></span>
      Cycling
    </button>
    <button
      type="button"
      role="tab"
      id="tab-code"
      aria-controls="rail-code"
      aria-selected="false"
      tabindex="-1"
      class={tab}
    >
      <span class="icon-[lucide--code] size-3.5" aria-hidden="true"></span>
      Code
    </button>
    <span
      data-indicator
      aria-hidden="true"
      class="absolute bottom-0 left-0 h-0.5 w-0 bg-accent transition-[transform,width] duration-200 ease-out"
    ></span>
  </div>
  <div
    data-track
    class="flex snap-x snap-mandatory [scrollbar-width:none] overflow-x-auto sm:grid sm:grid-cols-2 sm:gap-x-10 sm:overflow-visible"
  >
    <div
      id="rail-cycling"
      role="tabpanel"
      aria-labelledby="tab-cycling"
      class="w-full shrink-0 snap-start sm:w-auto"
    >
      <Rail
        label="Cycling"
        icon="bike"
        href="/activity/cycling"
        link="All rides"
      >
        <StatBand
          slot="band"
          stats={cyclingStats}
          caption={captions}
          selected={selected}
        />
        {
          rideGroups.map((group) => (
            <RailGroup label={group.label}>
              {group.items.map((ride) => (
                <li>
                  <RideRow ride={ride} />
                </li>
              ))}
            </RailGroup>
          ))
        }
      </Rail>
    </div>
    <div
      id="rail-code"
      role="tabpanel"
      aria-labelledby="tab-code"
      class="w-full shrink-0 snap-start sm:w-auto"
    >
      <Rail label="Code" icon="code" href="/activity/code" link="All repos">
        <StatBand
          slot="band"
          stats={codeStats}
          caption={captions.year}
          selected={selected}
        />
        {
          repoGroups.map((group) => (
            <RailGroup label={group.label}>
              {group.items.map((repo) => (
                <li>
                  <RepoRow repo={repo} username={SITE.githubUsername} />
                </li>
              ))}
            </RailGroup>
          ))
        }
      </Rail>
    </div>
  </div>
</div>
<Ticker items={ticker} />

<script>
  import { formatStat, type StatKind } from "@/home/format";
  import { PERIODS, type Period } from "@/home/stats";

  const COUNT_MS = 500;

  function isPeriod(value: string | null): value is Period {
    return PERIODS.some((period) => period === value);
  }

  function isKind(value: string | undefined): value is StatKind {
    return value === "distance" || value === "elevation" || value === "count";
  }

  /** The number a stat shows for each period, as the server rendered it. */
  function values(stat: HTMLElement): Partial<Record<Period, number>> {
    const parsed: unknown = JSON.parse(stat.dataset.values ?? "{}");
    const out: Partial<Record<Period, number>> = {};
    if (typeof parsed !== "object" || parsed === null) return out;
    for (const period of PERIODS) {
      const value = Reflect.get(parsed, period);
      if (typeof value === "number") out[period] = value;
    }
    return out;
  }

  function wirePeriods(root: HTMLElement) {
    const toggle = root.querySelector<HTMLElement>("[data-period-toggle]");
    if (!toggle) return;
    const radios = [
      ...toggle.querySelectorAll<HTMLButtonElement>("[role=radio]"),
    ];
    const stats = [...root.querySelectorAll<HTMLElement>("[data-stat]")].map(
      (el) => ({
        el,
        kind: isKind(el.dataset.kind) ? el.dataset.kind : ("count" as const),
        values: values(el),
        shown: 0,
      }),
    );
    const captions = [
      ...root.querySelectorAll<HTMLElement>("[data-period-caption]"),
    ];
    const still = window.matchMedia("(prefers-reduced-motion: reduce)");

    let frame = 0;
    function show(period: Period) {
      for (const stat of stats) stat.shown = stat.values[period] ?? 0;
      for (const caption of captions) {
        const parsed: unknown = JSON.parse(
          caption.dataset.periodCaption ?? "{}",
        );
        const text =
          typeof parsed === "object" && parsed !== null
            ? Reflect.get(parsed, period)
            : undefined;
        if (typeof text === "string") caption.textContent = text;
      }
      cancelAnimationFrame(frame);
      const from = stats.map((stat) => Number(stat.el.dataset.shown ?? 0));
      const started = performance.now();
      const paint = (t: number) => {
        const progress = still.matches
          ? 1
          : Math.min(1, (t - started) / COUNT_MS);
        // Ease out: the number lands softly rather than stopping dead.
        const eased = 1 - (1 - progress) ** 3;
        stats.forEach((stat, i) => {
          const at = from[i]! + (stat.shown - from[i]!) * eased;
          stat.el.textContent = formatStat(at, stat.kind);
        });
        if (progress < 1) frame = requestAnimationFrame(paint);
        else
          for (const stat of stats) stat.el.dataset.shown = String(stat.shown);
      };
      frame = requestAnimationFrame(paint);
    }

    // The value each stat is showing, so the next change counts from
    // there rather than from zero.
    const initial = radios.find(
      (r) => r.getAttribute("aria-checked") === "true",
    );
    const start = initial?.dataset.period;
    if (isPeriod(start ?? null)) {
      for (const stat of stats) {
        stat.el.dataset.shown = String(stat.values[start as Period] ?? 0);
      }
    }

    function choose(radio: HTMLButtonElement) {
      const period = radio.dataset.period ?? null;
      if (!isPeriod(period)) return;
      for (const r of radios) {
        r.setAttribute("aria-checked", String(r === radio));
        r.tabIndex = r === radio ? 0 : -1;
      }
      show(period);
    }

    radios.forEach((radio, index) => {
      radio.addEventListener("click", () => choose(radio));
      radio.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (step === undefined) return;
        event.preventDefault();
        const next = radios[(index + step + radios.length) % radios.length];
        next?.focus();
        if (next) choose(next);
      });
    });
  }

  function wireRails(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-track]");
    const indicator = root.querySelector<HTMLElement>("[data-indicator]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    if (!track || !indicator || tabs.length === 0) return;

    const panels = tabs.map((tab) =>
      root.querySelector<HTMLElement>(`#${tab.getAttribute("aria-controls")}`),
    );

    function select(index: number) {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
    }

    /** Puts the indicator at a point between tabs: 0.5 is halfway to the second. */
    const place = (position: number) => {
      const from = tabs[Math.floor(position)];
      const to = tabs[Math.min(Math.ceil(position), tabs.length - 1)];
      if (!from || !to) return;
      const fraction = position - Math.floor(position);
      const left =
        from.offsetLeft + (to.offsetLeft - from.offsetLeft) * fraction;
      const width =
        from.offsetWidth + (to.offsetWidth - from.offsetWidth) * fraction;
      indicator.style.transform = `translateX(${left}px)`;
      indicator.style.width = `${width}px`;
    };

    const position = () => track.scrollLeft / track.clientWidth;

    // A tap moves the indicator first and lets the track catch up, so the
    // scroll it causes must not drag the indicator back along the way.
    let leading = false;
    let settle: ReturnType<typeof setTimeout> | undefined;

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        const panel = panels[index];
        leading = true;
        indicator.style.transitionDuration = "";
        place(index);
        select(index);
        if (panel)
          track.scrollTo({ left: panel.offsetLeft, behavior: "smooth" });
      });
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (step === undefined) return;
        event.preventDefault();
        const next = tabs[(index + step + tabs.length) % tabs.length];
        next?.focus();
        next?.click();
      });
    });

    track.addEventListener("scroll", () => {
      clearTimeout(settle);
      settle = setTimeout(() => {
        leading = false;
      }, 120);
      if (leading) return;
      indicator.style.transitionDuration = "0s";
      place(position());
      const index = Math.round(position());
      if (tabs[index]?.getAttribute("aria-selected") !== "true") select(index);
    });

    const settled = () => {
      indicator.style.transitionDuration = "0s";
      place(Math.round(position()));
    };
    // The rails are wired again on every page load and the window outlives
    // them, so the listener leaves with the page.
    const controller = new AbortController();
    window.addEventListener("resize", settled, { signal: controller.signal });
    document.addEventListener("astro:before-swap", () => controller.abort(), {
      once: true,
    });
    settled();
  }

  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-rails]").forEach((root) => {
      wireRails(root);
      wirePeriods(root);
    });
  });
</script>
