---
import RepoRow from "@/components/activity/RepoRow.vue";
import RideRow from "@/components/cycling/RideRow.vue";
import { SITE } from "@/config";
import { loadRecentActivity } from "@/home/load";
import Rail from "./Rail.astro";

/**
 * The homepage's two rails side by side, or on a phone a track that snaps
 * one rail at a time, swiped or tapped into view through the tab row.
 * The track scrolls without the script; the script keeps the tabs in
 * step with it.
 */
const { rides, repos } = await loadRecentActivity();

const tab =
  "-mb-px flex cursor-pointer items-center gap-1.5 border-b-2 border-transparent pb-2 text-xs tracking-[0.14em] text-foreground/45 uppercase aria-selected:border-accent aria-selected:text-foreground";
---

<div class="page-column pt-6 pb-12 sm:pt-8" data-rails>
  <div
    role="tablist"
    aria-label="Activity"
    class="flex gap-6 border-b border-border sm:hidden"
  >
    <button
      type="button"
      role="tab"
      id="tab-cycling"
      aria-controls="rail-cycling"
      aria-selected="true"
      class={tab}
    >
      <span class="icon-[lucide--bike] size-3.5" aria-hidden="true"></span>
      Cycling
    </button>
    <button
      type="button"
      role="tab"
      id="tab-code"
      aria-controls="rail-code"
      aria-selected="false"
      class={tab}
    >
      <span class="icon-[lucide--code] size-3.5" aria-hidden="true"></span>
      Code
    </button>
  </div>
  <div
    data-track
    class="flex snap-x snap-mandatory [scrollbar-width:none] overflow-x-auto sm:grid sm:grid-cols-2 sm:gap-x-10 sm:overflow-visible"
  >
    <div
      id="rail-cycling"
      role="tabpanel"
      aria-labelledby="tab-cycling"
      class="w-full shrink-0 snap-start sm:w-auto"
    >
      <Rail
        label="Cycling"
        icon="bike"
        href="/activity/cycling"
        link="All rides"
      >
        {
          rides.map((ride) => (
            <li>
              <RideRow ride={ride} />
            </li>
          ))
        }
      </Rail>
    </div>
    <div
      id="rail-code"
      role="tabpanel"
      aria-labelledby="tab-code"
      class="w-full shrink-0 snap-start sm:w-auto"
    >
      <Rail label="Code" icon="code" href="/activity/code" link="All repos">
        {
          repos.map((repo) => (
            <li>
              <RepoRow repo={repo} username={SITE.githubUsername} />
            </li>
          ))
        }
      </Rail>
    </div>
  </div>
</div>

<script>
  function wireRails(root: HTMLElement) {
    const track = root.querySelector<HTMLElement>("[data-track]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[role=tab]")];
    if (!track || tabs.length === 0) return;

    const panels = tabs.map((tab) =>
      root.querySelector<HTMLElement>(`#${tab.getAttribute("aria-controls")}`),
    );

    function select(index: number) {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        const panel = panels[index];
        if (panel)
          track.scrollTo({ left: panel.offsetLeft, behavior: "smooth" });
        select(index);
      });
      tab.addEventListener("keydown", (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[event.key];
        if (step === undefined) return;
        event.preventDefault();
        const next = tabs[(index + step + tabs.length) % tabs.length];
        next?.focus();
        next?.click();
      });
    });

    // The track's own position is the truth once a swipe settles, so a
    // tap and a swipe end in the same state.
    let settle: ReturnType<typeof setTimeout> | undefined;
    track.addEventListener("scroll", () => {
      clearTimeout(settle);
      settle = setTimeout(() => {
        const index = Math.round(track.scrollLeft / track.clientWidth);
        if (tabs[index]?.getAttribute("aria-selected") !== "true")
          select(index);
      }, 80);
    });
  }

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-rails]")
      .forEach((root) => wireRails(root));
  });
</script>
