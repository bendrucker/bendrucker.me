---
/**
 * The row that opens a homepage rail: what it holds at left, where the rest
 * of it lives at right.
 */
export interface Props {
  label: string;
  href: string;
  /** The link's text, naming what the full page holds: "All rides". */
  link: string;
  as?: "h2" | "h3";
}

const { label, href, link, as: Tag = "h2" } = Astro.props;
---

<div
  class="flex items-baseline justify-between gap-4 border-b border-border pb-2.5"
>
  <Tag class="text-xs tracking-[0.14em] text-foreground/45 uppercase">
    {label}
  </Tag>
  <a
    href={href}
    class="inline-flex items-center gap-1 text-xs text-foreground/60 underline decoration-dashed underline-offset-4 hover:text-accent"
  >
    {link}
    <span class="icon-[lucide--arrow-right] size-3.5" aria-hidden="true"></span>
  </a>
</div>
