---
import { PERIOD_LABELS, PERIODS, type Period } from "@/home/stats";

/**
 * The window a stat band covers, set in the caption's own type so it reads
 * as the caption rather than as a control. Every band carries one and the
 * script in `Rails.astro` keeps them agreed, so choosing on either rail
 * moves both.
 */
export interface Props {
  selected: Period;
}

const { selected } = Astro.props;
---

<div
  role="radiogroup"
  aria-label="Totals over"
  data-period-toggle
  class="flex gap-3 text-[0.65rem] tracking-[0.14em] uppercase"
>
  {
    PERIODS.map((period) => (
      <button
        type="button"
        role="radio"
        aria-checked={period === selected}
        aria-label={PERIOD_LABELS[period].name}
        data-period={period}
        tabindex={period === selected ? 0 : -1}
        class="cursor-pointer text-foreground/35 transition-colors hover:text-foreground/70 aria-checked:text-foreground"
      >
        {PERIOD_LABELS[period].short}
      </button>
    ))
  }
</div>
