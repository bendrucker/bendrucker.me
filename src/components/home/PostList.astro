---
import type { CollectionEntry } from "astro:content";
import kebabcase from "lodash.kebabcase";
import { format } from "date-fns";
import { TZDate } from "@date-fns/tz";
import { getPath } from "@/blog/path";
import { SITE } from "@/config";

export interface Props {
  label: string;
  posts: CollectionEntry<"blog">[];
}

const { label, posts } = Astro.props;

const dated = posts.map(({ id, filePath, data }) => ({
  href: getPath(id, filePath),
  title: data.title,
  datetime: new TZDate(
    new Date(data.pubDatetime),
    data.timezone || SITE.timezone,
  ),
}));
---

<div class="mx-auto w-full max-w-home px-5 pt-6 sm:pt-11">
  <div class="sm:grid sm:grid-cols-[9.375rem_1fr] sm:items-start sm:gap-8">
    <h2
      class="pb-2.5 text-xs tracking-[0.14em] text-foreground/45 uppercase sm:pt-4.5 sm:pb-0"
    >
      {label}
    </h2>
    <ul class="flex flex-col">
      {
        dated.map(({ href, title, datetime }) => (
          <li>
            <a
              {href}
              class="flex items-baseline justify-between gap-4 border-t border-border py-3.5 hover:text-accent sm:gap-8"
            >
              <h3
                class="text-sm leading-[1.4] font-normal text-pretty sm:text-base"
                transition:name={kebabcase(title)}
              >
                {title}
              </h3>
              <time
                class="text-xs whitespace-nowrap text-foreground/45 sm:text-sm"
                datetime={datetime.toISOString()}
              >
                {format(datetime, "MMM yyyy")}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>
