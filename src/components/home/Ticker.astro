---
import type { TickerItem } from "@/home/records";

/**
 * A line of lifetime facts crawling under the rails, the one moving thing on
 * the page. The row is drawn twice so the loop has no seam, and it stops
 * under the pointer so a fact can be read or followed. Readers who asked for
 * less motion get the facts as a wrapped list instead.
 */
export interface Props {
  items: TickerItem[];
}

const { items } = Astro.props;

/** Long enough to read each fact as it passes, whatever the count. */
const seconds = Math.max(30, items.length * 7);
---

{
  items.length > 0 && (
    <div
      class="ticker page-column overflow-hidden border-t border-border py-3 text-xs text-foreground/55"
      style={`--ticker-seconds: ${seconds}s`}
      aria-label="Lifetime records"
    >
      <div class="ticker-track flex w-max motion-reduce:w-auto motion-reduce:flex-wrap motion-reduce:gap-y-1">
        {[0, 1].map((copy) => (
          <ul
            role="list"
            class:list={[
              "flex shrink-0 items-center motion-reduce:flex-wrap motion-reduce:gap-y-1",
              { "motion-reduce:hidden": copy === 1 },
            ]}
            aria-hidden={copy === 1 ? "true" : undefined}
          >
            {items.map((item) => (
              <li class="flex items-center">
                {item.href ? (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="whitespace-nowrap hover:text-accent"
                  >
                    {item.text}
                  </a>
                ) : (
                  <span class="whitespace-nowrap">{item.text}</span>
                )}
                <span class="px-3 text-foreground/30" aria-hidden="true">
                  &middot;
                </span>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  )
}

<style>
  @keyframes ticker {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  .ticker-track {
    animation: ticker var(--ticker-seconds) linear infinite;
  }
  .ticker:hover .ticker-track,
  .ticker:focus-within .ticker-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }
  }
</style>
