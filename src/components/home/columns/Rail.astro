---
import RailHeading from "@/components/home/RailHeading.astro";

interface Props {
  label: string;
  href: string;
  link: string;
}

const { label, href, link } = Astro.props;
---

<section>
  <RailHeading label={label} href={href} link={link} />
  <ul role="list" class="mt-3 flex flex-col gap-3">
    <slot />
  </ul>
</section>
