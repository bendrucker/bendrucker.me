---
import RailHeading from "./RailHeading.astro";

/** A homepage section: its heading row, then a list of rows. */
export interface Props {
  label: string;
  href: string;
  link: string;
}

const { label, href, link } = Astro.props;
---

<section>
  <RailHeading label={label} href={href} link={link} />
  <ul role="list">
    <slot />
  </ul>
</section>
