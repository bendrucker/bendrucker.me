---
import RailHeading from "./RailHeading.astro";

/**
 * A homepage section: its heading row, the list of rows, and a row at the
 * foot pointing on to the full page. On a phone the tabs above stand in
 * for the heading.
 */
export interface Props {
  label: string;
  icon: "bike" | "code";
  href: string;
}

const { label, icon, href } = Astro.props;
---

<section>
  <div class="hidden sm:block">
    <RailHeading label={label} icon={icon} href={href} />
  </div>
  <ul role="list" class="@container">
    <slot />
  </ul>
  <a
    href={href}
    aria-label={`More ${label.toLowerCase()}`}
    class="flex items-center justify-center gap-1 py-3 text-xs text-foreground/50 transition-colors hover:text-accent"
  >
    <span class="icon-[lucide--chevron-down] size-3.5" aria-hidden="true"
    ></span>
    More
  </a>
</section>
