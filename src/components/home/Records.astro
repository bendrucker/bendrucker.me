---
import type { RecordItem } from "@/home/records";

/**
 * A footnote of lifetime facts under the rails, set still and faint so it
 * reads after the numbers above it rather than competing with them.
 */
export interface Props {
  items: RecordItem[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div
      class="page-column border-t border-border py-3 text-xs text-foreground/55"
      aria-label="Lifetime records"
    >
      <ul role="list" class="flex flex-wrap items-center gap-y-1">
        {items.map((item) => (
          <li class="group flex items-center">
            {item.href ? (
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="whitespace-nowrap hover:text-accent"
              >
                {item.text}
              </a>
            ) : (
              <span class="whitespace-nowrap">{item.text}</span>
            )}
            <span
              class="px-2.5 text-foreground/30 group-last:hidden"
              aria-hidden="true"
            >
              &middot;
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}
