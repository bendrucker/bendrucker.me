---
import RepoCard from "@/components/activity/RepoCard.vue";
import RideCard from "@/components/cycling/RideCard.vue";
import { SITE } from "@/config";
import { formatFeedDate, type FeedItem } from "@/home/feed";

/**
 * One row of the merged feed: a gutter marking which source the card came
 * from and when it happened, beside the card itself.
 */
export interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const when = formatFeedDate(item.at);
---

<li class="flex gap-3">
  <div
    class="flex w-9 shrink-0 flex-col items-center gap-1 pt-1 text-foreground/45"
  >
    {
      item.kind === "ride" ? (
        <span class="icon-[lucide--bike] size-4" aria-hidden="true" />
      ) : (
        <span class="icon-[lucide--github] size-4" aria-hidden="true" />
      )
    }
    <span class="text-[10px] whitespace-nowrap">{when}</span>
    <span class="sr-only"
      >{item.kind === "ride" ? "Ride" : "Repo activity"}</span
    >
  </div>
  <div class="min-w-0 flex-1">
    {
      item.kind === "ride" ? (
        <RideCard ride={item.ride} headingAs="h3" />
      ) : (
        <RepoCard repo={item.repo} username={SITE.githubUsername} />
      )
    }
  </div>
</li>
