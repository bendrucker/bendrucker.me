---
import Layout from "./Layout.astro";
import Band from "@/components/about/Band.astro";
import { SITE } from "@/config";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout
  title={`${frontmatter.title} | ${SITE.title}`}
  sourcePath="src/pages/about.md"
  headerVariant="home"
>
  <main id="main-content">
    <Band />
    <section
      id="about"
      class="app-prose page-column mt-4 mb-28 sm:mt-6 prose-img:border-0"
    >
      <h1 class="sr-only">{frontmatter.title}</h1>
      <slot />
    </section>
  </main>
</Layout>
