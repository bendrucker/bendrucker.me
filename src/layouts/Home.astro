---
import Layout from "./Layout.astro";
import Band from "@/components/home/Band.astro";

/**
 * What every homepage variant shares: the site chrome in its home form, the
 * band, and the main landmark. A variant supplies only the rails.
 */
export interface Props {
  sourcePath: string;
}

const { sourcePath } = Astro.props;
---

<Layout
  description="Programmer, cyclist, and photographer."
  sourcePath={sourcePath}
  headerVariant="home"
>
  <main id="main-content" data-layout="index">
    <Band />
    <slot />
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent = document.querySelector("#main-content");
    if (mainContent instanceof HTMLElement && mainContent.dataset.layout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
