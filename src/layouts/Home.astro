---
import Layout from "./Layout.astro";
import Band from "@/components/home/Band.astro";
import Intro from "@/components/home/Intro.astro";

/**
 * What every homepage variant shares: the site chrome, a masthead, and the
 * main landmark. The band is the photo masthead at half height under the
 * nav-only header; the text masthead is a line under the default header.
 */
export interface Props {
  sourcePath: string;
  masthead?: "band" | "text";
}

const { sourcePath, masthead = "text" } = Astro.props;
---

<Layout
  description="Programmer, cyclist, and photographer."
  sourcePath={sourcePath}
  headerVariant={masthead === "band" ? "home" : "default"}
>
  <main id="main-content" data-layout="index">
    {masthead === "band" ? <Band /> : <Intro />}
    <slot />
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent = document.querySelector("#main-content");
    if (mainContent instanceof HTMLElement && mainContent.dataset.layout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
