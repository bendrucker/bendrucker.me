---
import Home from "@/layouts/Home.astro";

/**
 * The homepage mastheads under comparison, each a page of its own over the
 * same rails.
 */
const variants = [
  {
    href: "/design/home/text",
    label: "Text",
    note: "The default header with a one-line introduction beneath it.",
  },
  {
    href: "/design/home/band",
    label: "Band",
    note: "The photo masthead at half height under the nav-only header.",
  },
];
---

<Home sourcePath="src/pages/design/home/index.astro">
  <div class="page-column pt-8">
    <h2 class="text-xs tracking-[0.14em] text-foreground/45 uppercase">
      Mastheads
    </h2>
    <ul role="list" class="mt-3 flex flex-col gap-3">
      {
        variants.map((variant) => (
          <li>
            <a
              href={variant.href}
              class="text-base underline decoration-dashed underline-offset-4 hover:text-accent"
            >
              {variant.label}
            </a>
            <p class="text-sm text-foreground/60">{variant.note}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Home>
