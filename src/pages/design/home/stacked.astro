---
import Home from "@/layouts/Home.astro";
import RailHeading from "@/components/home/RailHeading.astro";
import MapCredits from "@/components/home/MapCredits.astro";
import RideCard from "@/components/cycling/RideCard.vue";
import RepoCard from "@/components/activity/RepoCard.vue";
import { loadRecentActivity } from "@/home/load";
import { SITE } from "@/config";

const { rides, repos } = await loadRecentActivity();
---

<Home sourcePath="src/pages/design/home/stacked.astro">
  <div
    class="mx-auto flex w-full max-w-home flex-col gap-10 px-5 pt-6 pb-12 sm:gap-14 sm:pt-11"
  >
    <section class="flex flex-col gap-4">
      <RailHeading label="Cycling" href="/activity/cycling" link="All rides" />
      <div class="flex flex-col gap-4">
        {rides.map((ride) => <RideCard ride={ride} />)}
      </div>
    </section>

    <section class="flex flex-col gap-4">
      <RailHeading label="Code" href="/activity/code" link="All repos" />
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          repos.map((repo) => (
            <RepoCard repo={repo} username={SITE.githubUsername} />
          ))
        }
      </div>
    </section>

    <MapCredits rides={rides} />
  </div>
</Home>
