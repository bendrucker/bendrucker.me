---
import { getCollection } from "astro:content";
import type { GetStaticPathsOptions } from "astro";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import Pagination from "@/components/Pagination.astro";
import { getUniqueTags, getPostsByTag } from "@/blog/tags";
import { SITE } from "@/config";

export const prerender = true;

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("blog");
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage,
    });
  });
}

const params = Astro.params;
const { tag } = params;
const { page, tagName } = Astro.props;
---

<Layout title={`Tag: ${tagName} | ${SITE.title}`} sourcePath="src/pages/tags/[tag]/[...page].astro">
  <Main
    pageTitle={[`Tag:`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={`All the articles with the tag "${tagName}".`}
  >
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>
    <LinkButton
      href="/tags"
      class="focus-outline mb-6 inline-flex items-center text-foreground/75"
    >
      <IconChevronLeft class="inline-block size-5 rtl:rotate-180" />
      <span>All tags</span>
    </LinkButton>
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />
</Layout>
