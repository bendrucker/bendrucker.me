---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/blog/posts";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
---

<Layout
  description="Programmer, cyclist, and photographer, living in San Francisco."
  sourcePath="src/pages/index.astro"
>
  <main
    id="main-content"
    data-layout="index"
    class="flex flex-1 flex-col justify-center"
  >
    <div class="bridge" aria-hidden="true">
      <svg
        viewBox="0 0 1200 300"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
        stroke-linecap="round"
      >
        <path d="M0 234 H1200 M0 244 H1200"></path>
        <path
          d="M317 40 V252 M343 40 V252 M311 62 H349 M311 108 H349 M311 154 H349 M311 200 H349"
        ></path>
        <path
          d="M857 40 V252 M883 40 V252 M851 62 H889 M851 108 H889 M851 154 H889 M851 200 H889"
        ></path>
        <path d="M330 40 Q600 360 870 40"></path>
        <path d="M330 40 Q185 155 60 230 M870 40 Q1015 155 1140 230"></path>
        <path
          d="M375 89 V234 M420 129 V234 M465 160 V234 M510 182 V234 M555 196 V234 M600 200 V234 M645 196 V234 M690 182 V234 M735 160 V234 M780 129 V234 M825 89 V234"
        ></path>
      </svg>
    </div>
    <section id="hero" class="pt-8 pb-6 text-center">
      <figure class="portrait mx-auto mb-6">
        <img
          src="/images/ben-drucker-cut.png"
          alt="Ben Drucker"
          width="512"
          height="512"
        />
      </figure>
      <p class="roles flex items-center justify-center gap-x-3">
        <LinkButton
          href="/activity/code"
          class="underline decoration-dashed underline-offset-4"
          >Programmer</LinkButton
        >
        <span aria-hidden="true">&middot;</span>
        <LinkButton
          href="https://www.strava.com/athletes/5723594"
          class="underline decoration-dashed underline-offset-4"
          >cyclist</LinkButton
        >
        <span aria-hidden="true">&middot;</span>
        <span>photographer</span>
      </p>
      <p
        class="place text-foreground/60 mt-2 flex items-center justify-center gap-x-1.5 text-sm"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="size-4"
        >
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        San Francisco
      </p>
    </section>
    <canvas class="fog" aria-hidden="true"></canvas>

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map((data) => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        </>
      )
    }
  </main>
</Layout>

<style>
  /* Centering puts the figure lower than it reads. Reserve space below it so
     the group settles around the upper third of the open area. */
  #main-content {
    padding-bottom: 14svh;
  }

  .portrait {
    position: relative;
    /* Larger and viewport-driven so it fills more of a phone screen, capped so
       it stays reasonable on desktop. */
    width: clamp(11rem, 55vw, 16rem);
    height: clamp(11rem, 55vw, 16rem);
    --shadow-rgb: 20, 28, 40;
    --shadow-a: 0.16;
    --sx: 0px;
    --sy: 8px;
  }

  /* The light-theme shadow is invisible on the dark backdrop (#212737), so
     darken it to black and strengthen it just enough to still read as a lift. */
  html[data-theme="dark"] .portrait {
    --shadow-rgb: 0, 0, 0;
    --shadow-a: 0.3;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1)
      drop-shadow(
        var(--sx) var(--sy) 10px rgba(var(--shadow-rgb), var(--shadow-a))
      );
    transition: filter 150ms ease-out;
    /* Fade the torso into the page background. This is the resting state for
       browsers that give us no WebGL context to fog it with instead. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 42%,
      rgba(0, 0, 0, 0.5) 64%,
      rgba(0, 0, 0, 0.15) 85%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 42%,
      rgba(0, 0, 0, 0.5) 64%,
      rgba(0, 0, 0, 0.15) 85%,
      transparent 100%
    );
  }

  /* The fog does the work of the fade, but it thins out at its own edges and
     can't be trusted to cover the bottom of the cutout. The image holds a late,
     shallow ramp underneath so there is never a hard cut waiting behind a gap
     in the weather. */
  .portrait[data-fog] img {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 60%,
      rgba(0, 0, 0, 0.7) 78%,
      rgba(0, 0, 0, 0.25) 90%,
      transparent 99%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 60%,
      rgba(0, 0, 0, 0.7) 78%,
      rgba(0, 0, 0, 0.25) 90%,
      transparent 99%
    );
  }

  /* Nothing between body and these layers is positioned, so absolute here
     resolves against the document itself. That lets the scene break out of the
     max-width column and fill the first viewport edge to edge. */
  .fog {
    position: absolute;
    top: 44svh;
    left: 0;
    width: 100%;
    height: 56svh;
    pointer-events: none;
  }

  .bridge {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100svh;
    /* The art stays legible on a phone by keeping a minimum drawn width and
       letting the sides crop instead of the towers shrinking away. */
    overflow: clip;
    pointer-events: none;
    color: var(--foreground);
    opacity: 0.3;
  }

  .bridge svg {
    position: absolute;
    bottom: 20svh;
    left: 50%;
    width: max(100%, 40rem);
    transform: translate(-50%, var(--drift, 0px));
  }

  @media (max-width: 640px) {
    .bridge svg {
      bottom: 34svh;
    }
  }

  /* The bridge paints first, then the figure, then the fog canvas last in DOM
     order, which is what lets the bank swallow the torso and the deck. The
     text is the one thing that has to stand on top of the weather. */
  .roles,
  .place {
    position: relative;
    z-index: 1;
  }

  /* At the base size the triplet reaches both edges of a phone. Give it back a
     margin here so it keeps to one line, since wrapping costs the symmetry the
     three words are there for. */
  @media (max-width: 640px) {
    .roles {
      column-gap: 0.5rem;
      font-size: 0.9rem;
    }
  }

  :global(footer) {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  // Re-bound on every ClientRouter navigation; abort the previous binding so
  // window/document listeners don't accumulate across visits to the home page.
  let tiltController: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    tiltController?.abort();
    tiltController = undefined;

    const portrait = document.querySelector<HTMLElement>(".portrait");
    if (
      !portrait ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;

    tiltController = new AbortController();
    const { signal } = tiltController;

    const REACH = 6;
    const clamp = (n: number) => Math.max(-1, Math.min(1, n));
    const set = (sx: number, sy: number) => {
      portrait.style.setProperty("--sx", `${sx.toFixed(1)}px`);
      portrait.style.setProperty("--sy", `${(8 + sy).toFixed(1)}px`);
    };

    const onOrient = (e: DeviceOrientationEvent) => {
      if (e.gamma == null || e.beta == null) return;
      set(clamp(e.gamma / 40) * REACH, clamp((e.beta - 45) / 40) * REACH);
    };

    // Android and pre-13 iOS expose the gyroscope without a prompt. iOS 13+
    // gates it behind DeviceOrientationEvent.requestPermission(), which pops a
    // system dialog on first tap; we skip that, so those visitors keep the
    // resting shadow.
    const DOE =
      window.DeviceOrientationEvent as typeof DeviceOrientationEvent & {
        requestPermission?: () => Promise<PermissionState>;
      };
    if (DOE && typeof DOE.requestPermission !== "function") {
      window.addEventListener("deviceorientation", onOrient, { signal });
    }

    // Desktop proxy: no gyroscope, so map the cursor across the viewport to the
    // same range, with the shadow falling away from the pointer as if it were
    // the light source. Fine pointers only, to avoid fighting touch scrolling.
    if (window.matchMedia("(pointer: fine)").matches) {
      window.addEventListener(
        "pointermove",
        (e) => {
          set(
            -clamp((e.clientX / window.innerWidth) * 2 - 1) * REACH,
            -clamp((e.clientY / window.innerHeight) * 2 - 1) * REACH,
          );
        },
        { signal },
      );
    }
  });
</script>

<script>
  // A fog bank rises from the bottom of the page. The figure stands in it, the
  // bridge behind it loses its deck to it, and the caption rests on top of it.
  // It is fractal noise in planes stacked back to front, each drifting through
  // the 3D field at its own scale and speed, so the parallax between them
  // reads as a volume rather than a single texture. The field origin is random
  // per page load: no two visits get the same weather.
  const BAND_TOP = 0.0; // canvas-relative height where the first wisps appear
  const BAND_SOLID = 0.34; // and where the sweep saturates into solid bank
  const SHEER = 0.32; // most the fog can hide where it first meets the chest
  const VEIL = 0.2; // peak opacity of the faint haze hanging behind the bank
  const FRONT = 0.2; // peak opacity of the streaks crossing in front of it
  const TINT_THIN = 0.05; // page-to-text colour step of the thinnest wisps
  const TINT_DENSE = 0.16; // and of the solid bank, so the bottom reads lightest
  const DPR_CAP = 1.0; // the canvas is full bleed now, so retina is traded away
  const SPAN = 2.6; // noise cells down the canvas; fewer means larger shapes
  const DRIFT = 0.22; // fraction of scroll the bridge keeps, sinking it away

  const VERTEX = `
    attribute vec2 aPos;
    varying vec2 vUv;
    void main() {
      vUv = vec2(aPos.x * 0.5 + 0.5, 0.5 - aPos.y * 0.5);
      gl_Position = vec4(aPos, 0.0, 1.0);
    }
  `;

  const FRAGMENT = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
      precision highp float;
    #else
      precision mediump float;
    #endif

    varying vec2 vUv;
    uniform float uTime;
    uniform vec3 uOrigin;
    uniform vec2 uScale;
    uniform vec2 uBand;
    uniform float uSheer;
    uniform float uVeil;
    uniform float uFront;
    uniform vec2 uTint;
    uniform vec3 uFore;
    uniform vec3 uPage;

    float hash(vec3 p) {
      p = fract(p * 0.1031);
      p += dot(p, p.zyx + 31.32);
      return fract((p.x + p.y) * p.z);
    }

    float noise(vec3 x) {
      vec3 i = floor(x);
      vec3 f = x - i;
      f = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(
          mix(hash(i), hash(i + vec3(1.0, 0.0, 0.0)), f.x),
          mix(hash(i + vec3(0.0, 1.0, 0.0)), hash(i + vec3(1.0, 1.0, 0.0)), f.x),
          f.y),
        mix(
          mix(hash(i + vec3(0.0, 0.0, 1.0)), hash(i + vec3(1.0, 0.0, 1.0)), f.x),
          mix(hash(i + vec3(0.0, 1.0, 1.0)), hash(i + vec3(1.0, 1.0, 1.0)), f.x),
          f.y),
        f.z);
    }

    float fbm3(vec3 p) {
      float sum = 0.0;
      float amp = 0.5;
      for (int i = 0; i < 3; i++) {
        sum += amp * noise(p);
        p = p * 2.03 + 7.1;
        amp *= 0.5;
      }
      return sum;
    }

    float fbm4(vec3 p) {
      float sum = 0.0;
      float amp = 0.5;
      for (int i = 0; i < 4; i++) {
        sum += amp * noise(p);
        p = p * 2.03 + 7.1;
        amp *= 0.5;
      }
      return sum;
    }

    void main() {
      vec2 ground = vUv * uScale;

      // Farthest plane: a broad slow haze too faint to have shapes of its own.
      // It hangs behind the bank and gives the shapes in front something to
      // stand out against.
      vec3 pv = vec3(ground * 0.55, uTime * 0.012) + uOrigin + vec3(11.0, 5.0, 17.0);
      pv.x += uTime * 0.006;
      float veil = fbm3(pv);

      // The cutoff sweeps down through the range of each field, so the top of
      // the band passes only the densest cores and the bottom passes all of it.
      // Swaying the sweep by the slowest field keeps the bank's skyline from
      // running level across the viewport.
      float depth = smoothstep(uBand.x, uBand.y, vUv.y + (veil - 0.42) * 0.35);
      float dVeil = smoothstep(0.3, 0.8, veil) * uVeil * smoothstep(0.05, 0.5, depth);

      // Middle plane: distinct billows drifting against the near bank, which
      // is where most of the parallax comes from.
      vec3 pm = vec3(ground * 0.95, uTime * 0.03) + uOrigin + vec3(3.0, 23.0, 7.0);
      pm.x -= uTime * 0.018;
      float mid = fbm4(pm);
      float dMid = smoothstep(0.6 - depth * 0.45, 0.95 - depth * 0.55, mid) *
        mix(0.1, 0.8, depth);

      // Near plane: the churning face of the bank. Looking the field up
      // through another octave of itself curls it. Without that the pattern
      // reads as a texture being panned.
      vec3 pn = vec3(ground * 1.35, uTime * 0.055) + uOrigin + vec3(29.0, 13.0, 31.0);
      float warp = fbm3(pn * 0.5 - vec3(uTime * 0.025, 0.0, 0.0));
      vec3 curled = pn + vec3(warp * 1.5 - uTime * 0.05, warp * 0.9, 0.0);
      float cloud = fbm4(curled);
      float dNear = smoothstep(0.64 - depth * 0.62, 0.9 - depth * 0.78, cloud);

      // Sampling the same field a step higher tells us whether this point sits
      // under thicker fog than itself. Those undersides pick up extra tint, a
      // cheap stand-in for skylight that gives the billows form.
      float above = fbm4(curled - vec3(0.0, 0.35, 0.0));
      float shade = clamp((cloud - above) * 2.5, 0.0, 1.0);

      // Front plane: fine fast streaks crossing the face of the bank.
      vec3 pf = vec3(ground * 2.1, uTime * 0.07) + uOrigin + vec3(41.0, 2.0, 53.0);
      pf.x += uTime * 0.045;
      float streak = fbm3(pf);
      float dFront = smoothstep(0.48, 0.8, streak) * uFront *
        smoothstep(0.05, 0.35, depth);

      // The deck of the bank: a guaranteed fill that owes nothing to the
      // fields, so the bottom of the page is always solid fog no matter how
      // thin a draw the weather turned up. The noise layers give its surface
      // and everything above it their churn.
      float dDeck = smoothstep(uBand.y * 0.6, uBand.y * 1.7, vUv.y + (veil - 0.42) * 0.35);

      // The fog is lightest where it is thickest. Every tint is a step from
      // the page colour towards the text colour that grows with depth and each
      // layer's own field, so in both themes the bank brightens towards the
      // bottom relative to its surroundings and the old read of the page going
      // darker underneath is gone. The bank never matches the page exactly
      // down there, which is fine: the figure now dissolves into fog rather
      // than into bare page.
      float tDeck = uTint.y * (0.7 + 0.6 * smoothstep(0.2, 0.7, cloud));
      float tVeil = uTint.y * 1.1 * smoothstep(0.3, 0.9, veil);
      float tMid = mix(uTint.x, uTint.y, depth) * (0.6 + 0.5 * smoothstep(0.3, 0.8, mid));
      float tNear = mix(uTint.x, uTint.y, depth) + shade * 0.1;
      float tFront = uTint.y * 0.9 * smoothstep(0.45, 0.9, streak);

      // Premultiplied over, composited back to front.
      vec3 rgb = mix(uPage, uFore, tDeck) * dDeck;
      float a = dDeck;
      rgb = mix(uPage, uFore, tVeil) * dVeil + rgb * (1.0 - dVeil);
      a = dVeil + a * (1.0 - dVeil);
      rgb = mix(uPage, uFore, tMid) * dMid + rgb * (1.0 - dMid);
      a = dMid + a * (1.0 - dMid);
      rgb = mix(uPage, uFore, tNear) * dNear + rgb * (1.0 - dNear);
      a = dNear + a * (1.0 - dNear);
      rgb = mix(uPage, uFore, tFront) * dFront + rgb * (1.0 - dFront);
      a = dFront + a * (1.0 - dFront);

      // Capping how much it can hide near the top keeps the chest behind a
      // cloud you can see through. The cap lifts as the fog deepens, so the
      // bank takes over completely by the time it reaches the caption.
      float cap = mix(uSheer, 1.0, depth * depth);
      float capped = min(a, cap);
      rgb *= capped / max(a, 0.0001);
      a = capped;

      // The sides and bottom run off the viewport, so the only canvas edge
      // that could ever show is the top. Fade it out so a stray dense core in
      // the field cannot print a hard line there.
      float fade = smoothstep(0.0, 0.12, vUv.y);
      gl_FragColor = vec4(rgb * fade, a * fade);
    }
  `;

  const compile = (gl: WebGLRenderingContext, type: number, source: string) => {
    const shader = gl.createShader(type);
    if (!shader) return null;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (gl.getShaderParameter(shader, gl.COMPILE_STATUS)) return shader;
    gl.deleteShader(shader);
    return null;
  };

  const link = (gl: WebGLRenderingContext) => {
    const vertex = compile(gl, gl.VERTEX_SHADER, VERTEX);
    const fragment = compile(gl, gl.FRAGMENT_SHADER, FRAGMENT);
    if (!vertex || !fragment) return null;
    const program = gl.createProgram();
    if (!program) return null;
    gl.attachShader(program, vertex);
    gl.attachShader(program, fragment);
    gl.linkProgram(program);
    gl.deleteShader(vertex);
    gl.deleteShader(fragment);
    if (gl.getProgramParameter(program, gl.LINK_STATUS)) return program;
    gl.deleteProgram(program);
    return null;
  };

  // Computed colours arrive as rgb() strings, and the shader wants the same
  // sRGB values the page is painted with.
  const channels = (value: string) =>
    (value.match(/[\d.]+/g) ?? []).slice(0, 3).map((n) => Number(n) / 255);

  let teardown: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    teardown?.();
    teardown = undefined;

    const figure = document.querySelector<HTMLElement>(".portrait");
    const canvas = document.querySelector<HTMLCanvasElement>("canvas.fog");
    const bridge = document.querySelector<SVGElement>(".bridge svg");
    if (!figure || !canvas) return;

    const gl = canvas.getContext("webgl", {
      alpha: true,
      antialias: false,
      depth: false,
      premultipliedAlpha: true,
    });
    if (!gl) return;

    const program = link(gl);
    if (!program) return;

    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    // One oversized triangle covers the clip volume with no seam down the
    // middle for the noise to catch on.
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    const position = gl.getAttribLocation(program, "aPos");
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

    gl.useProgram(program);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

    const uTime = gl.getUniformLocation(program, "uTime");
    const uOrigin = gl.getUniformLocation(program, "uOrigin");
    const uScale = gl.getUniformLocation(program, "uScale");
    const uFore = gl.getUniformLocation(program, "uFore");
    const uPage = gl.getUniformLocation(program, "uPage");

    gl.uniform2f(gl.getUniformLocation(program, "uBand"), BAND_TOP, BAND_SOLID);
    gl.uniform1f(gl.getUniformLocation(program, "uSheer"), SHEER);
    gl.uniform1f(gl.getUniformLocation(program, "uVeil"), VEIL);
    gl.uniform1f(gl.getUniformLocation(program, "uFront"), FRONT);
    gl.uniform2f(
      gl.getUniformLocation(program, "uTint"),
      TINT_THIN,
      TINT_DENSE,
    );
    gl.uniform3f(
      uOrigin,
      Math.random() * 64,
      Math.random() * 64,
      Math.random() * 64,
    );

    const paint = () => {
      const style = getComputedStyle(document.body);
      const page = channels(style.backgroundColor);
      const foreground = channels(style.color);
      if (page.length < 3 || foreground.length < 3) return;
      gl.uniform3f(uPage, page[0], page[1], page[2]);
      gl.uniform3f(uFore, foreground[0], foreground[1], foreground[2]);
    };

    const measure = () => {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      if (!width || !height) return false;
      const dpr = Math.min(window.devicePixelRatio || 1, DPR_CAP);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      // Banks are wider than they are tall, so the field is stretched across
      // rather than sampled square.
      gl.uniform2f(uScale, (SPAN * width) / height / 1.7, SPAN);
      return true;
    };

    let frame = 0;
    let previous = 0;
    let elapsed = 0;
    let visible = true;

    const render = () => {
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform1f(uTime, elapsed);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    // The bridge lags the page as it scrolls, sinking into the bank rather
    // than riding up with the content. Folding it into the render loop means
    // no scroll listener to tear down and reduced motion skips it for free,
    // since that path never starts the loop.
    let drifted = -1;
    const parallax = () => {
      if (!bridge || window.scrollY === drifted) return;
      drifted = window.scrollY;
      bridge.style.setProperty("--drift", `${(drifted * DRIFT).toFixed(1)}px`);
    };

    const draw = (now: number) => {
      frame = requestAnimationFrame(draw);
      const dt = Math.min((now - previous) / 1000, 0.05);
      previous = now;
      if (!visible) return;
      parallax();
      elapsed += dt;
      render();
    };

    const still = window.matchMedia("(prefers-reduced-motion: reduce)");

    const resize = new ResizeObserver(() => {
      if (!measure()) return;
      if (still.matches) render();
    });
    resize.observe(canvas);

    const observer = new IntersectionObserver((entries) => {
      visible = entries[entries.length - 1].isIntersecting;
    });
    observer.observe(canvas);

    const onVisibility = () => {
      visible = !document.hidden;
    };
    document.addEventListener("visibilitychange", onVisibility);

    // The theme toggle swaps the page colour out from under the fog.
    const theme = new MutationObserver(() => {
      paint();
      if (still.matches) render();
    });
    theme.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme", "class"],
    });

    paint();
    if (!measure()) return;
    figure.dataset.fog = "on";

    // Reduced motion still gets fog, just a photograph of it.
    if (still.matches) render();
    else {
      previous = performance.now();
      frame = requestAnimationFrame(draw);
    }

    teardown = () => {
      cancelAnimationFrame(frame);
      resize.disconnect();
      observer.disconnect();
      theme.disconnect();
      document.removeEventListener("visibilitychange", onVisibility);
      gl.deleteProgram(program);
      gl.deleteBuffer(buffer);
      delete figure.dataset.fog;
    };
  });
</script>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
