---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/blog/posts";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
---

<Layout description="Programmer, cyclist, and photographer." sourcePath="src/pages/index.astro">
  <main id="main-content" data-layout="index" class="flex flex-1 flex-col justify-center">
    <section id="hero" class="pt-8 pb-6 text-center">
      <figure class="portrait mx-auto mb-6">
        <img src="/images/ben-drucker-cut.png" alt="Ben Drucker" width="512" height="512" />
        <canvas class="dissolve" aria-hidden="true"></canvas>
      </figure>
      <p>
        <LinkButton href="/activity/code" class="underline decoration-dashed underline-offset-4">Programmer</LinkButton>, <LinkButton href="https://www.strava.com/athletes/5723594" class="underline decoration-dashed underline-offset-4">cyclist</LinkButton>, and photographer, living in San Francisco.
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map(data => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        </>
      )
    }

  </main>
</Layout>

<style>
  /* Centering puts the figure lower than it reads. Reserve space below it so
     the group settles around the upper third of the open area. */
  #main-content {
    padding-bottom: 14svh;
  }

  .portrait {
    position: relative;
    /* Larger and viewport-driven so it fills more of a phone screen, capped so
       it stays reasonable on desktop. */
    width: clamp(11rem, 55vw, 16rem);
    height: clamp(11rem, 55vw, 16rem);
    --shadow-rgb: 20, 28, 40;
    --shadow-a: 0.16;
    --sx: 0px;
    --sy: 8px;
  }

  /* The light-theme shadow is invisible on the dark backdrop (#212737), so
     darken it to black and strengthen it just enough to still read as a lift. */
  html[data-theme="dark"] .portrait {
    --shadow-rgb: 0, 0, 0;
    --shadow-a: 0.3;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1)
      drop-shadow(var(--sx) var(--sy) 10px rgba(var(--shadow-rgb), var(--shadow-a)));
    transition: filter 150ms ease-out;
    /* Pronounced fade: solid through the face and shoulders, then the torso
       dissolves into the page background. This is also the resting state when
       the canvas is unavailable or motion is reduced. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 42%,
      rgba(0, 0, 0, 0.5) 64%,
      rgba(0, 0, 0, 0.15) 85%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 42%,
      rgba(0, 0, 0, 0.5) 64%,
      rgba(0, 0, 0, 0.15) 85%,
      transparent 100%
    );
  }

  /* The canvas redraws the body from the chest down, so the image stops there
     and hands off across a short overlap band. */
  .portrait[data-dissolve] img {
    -webkit-mask-image: linear-gradient(to bottom, #000 42%, transparent 48%);
    mask-image: linear-gradient(to bottom, #000 42%, transparent 48%);
  }

  .dissolve {
    position: absolute;
    top: 0;
    left: -12%;
    width: 124%;
    /* Runs well past the figure so motes stay alive as they drift down behind
       the caption. */
    height: 190%;
    pointer-events: none;
    /* Matches the image, which the canvas has to blend into seamlessly. */
    filter: grayscale(1);
    /* Behind the caption that follows the figure, so falling motes pass under
       the text rather than over it. */
    z-index: -1;
  }
</style>

<script>
  // Re-bound on every ClientRouter navigation; abort the previous binding so
  // window/document listeners don't accumulate across visits to the home page.
  let tiltController: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    tiltController?.abort();
    tiltController = undefined;

    const portrait = document.querySelector<HTMLElement>(".portrait");
    if (!portrait || window.matchMedia("(prefers-reduced-motion: reduce)").matches)
      return;

    tiltController = new AbortController();
    const { signal } = tiltController;

    const REACH = 6;
    const clamp = (n: number) => Math.max(-1, Math.min(1, n));
    const set = (sx: number, sy: number) => {
      portrait.style.setProperty("--sx", `${sx.toFixed(1)}px`);
      portrait.style.setProperty("--sy", `${(8 + sy).toFixed(1)}px`);
    };

    const onOrient = (e: DeviceOrientationEvent) => {
      if (e.gamma == null || e.beta == null) return;
      set(clamp(e.gamma / 40) * REACH, clamp((e.beta - 45) / 40) * REACH);
    };

    // Android and pre-13 iOS expose the gyroscope without a prompt. iOS 13+
    // gates it behind DeviceOrientationEvent.requestPermission(), which pops a
    // system dialog on first tap; we skip that, so those visitors keep the
    // resting shadow.
    const DOE = window.DeviceOrientationEvent as typeof DeviceOrientationEvent & {
      requestPermission?: () => Promise<PermissionState>;
    };
    if (DOE && typeof DOE.requestPermission !== "function") {
      window.addEventListener("deviceorientation", onOrient, { signal });
    }

    // Desktop proxy: no gyroscope, so map the cursor across the viewport to the
    // same range, with the shadow falling away from the pointer as if it were
    // the light source. Fine pointers only, to avoid fighting touch scrolling.
    if (window.matchMedia("(pointer: fine)").matches) {
      window.addEventListener(
        "pointermove",
        e => {
          set(
            -clamp((e.clientX / window.innerWidth) * 2 - 1) * REACH,
            -clamp((e.clientY / window.innerHeight) * 2 - 1) * REACH,
          );
        },
        { signal },
      );
    }
  });
</script>

<script>
  // Below the chest the canvas draws the portrait instead of the image element,
  // so the photo stays sharp while a ragged front eats it a grain at a time.
  // Every grain that goes releases a mote that falls down the page. The front
  // sits low and barely moves at first. Leave the page open and it climbs.
  const CELL = 3; // css px per grain
  const ZONE_TOP = 0.42; // where the image hands the body to the canvas
  const HANDOFF = 0.06; // overlap band matching the image mask ramp
  const REST_FRONT = 0.78; // where the front rests, as a fraction of the figure
  const PEAK_FRONT = 0.5; // how far up it climbs once it gets going
  const FEATHER = 0.1; // depth over which a grain goes from whole to gone
  const PAD = 0.12; // canvas overhang each side, as a fraction of the figure
  const LIFE = 9; // seconds a drifting mote stays visible
  const MOTE_LIMIT = 1600;
  const LATTICE = 64; // noise field resolution
  const GRAIN = 9; // css px per noise lattice step
  const PATIENCE = 210; // seconds on the page before the front starts climbing
  const CLIMB = 180; // seconds it then takes to reach the peak

  interface Cell {
    x: number;
    y: number;
    v: number; // luminance
    a: number; // source alpha
    nx: number; // position in the noise field
    ny: number;
  }

  interface Mote {
    x: number;
    y: number;
    vx: number;
    vy: number;
    v: number;
    a: number;
    age: number;
  }

  const lattice = Float32Array.from({ length: LATTICE * LATTICE }, () => Math.random());

  // Value noise over a wrapping lattice, smoothstepped so the field flows
  // instead of stepping between lattice points.
  const noise = (x: number, y: number) => {
    const xi = Math.floor(x);
    const yi = Math.floor(y);
    const xf = x - xi;
    const yf = y - yi;
    const fx = xf * xf * (3 - 2 * xf);
    const fy = yf * yf * (3 - 2 * yf);
    const x0 = xi & (LATTICE - 1);
    const x1 = (xi + 1) & (LATTICE - 1);
    const y0 = (yi & (LATTICE - 1)) * LATTICE;
    const y1 = ((yi + 1) & (LATTICE - 1)) * LATTICE;
    const top = lattice[y0 + x0] + (lattice[y0 + x1] - lattice[y0 + x0]) * fx;
    const bottom = lattice[y1 + x0] + (lattice[y1 + x1] - lattice[y1 + x0]) * fx;
    return top + (bottom - top) * fy;
  };

  const clamp = (n: number) => Math.min(Math.max(n, 0), 1);

  let teardown: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    teardown?.();
    teardown = undefined;

    const figure = document.querySelector<HTMLElement>(".portrait");
    const img = figure?.querySelector("img");
    const canvas = figure?.querySelector<HTMLCanvasElement>("canvas.dissolve");
    const ctx = canvas?.getContext("2d");
    if (!figure || !img || !canvas || !ctx) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    let cells: Cell[] = [];
    let gone = new Uint8Array(0);
    let fade: CanvasGradient | undefined;
    const motes: Mote[] = [];
    const grays = Array.from({ length: 64 }, (_, i) => `rgb(${i * 4},${i * 4},${i * 4})`);

    let width = 0;
    let height = 0;
    let pad = 0;
    let frame = 0;
    let previous = 0;
    let elapsed = 0;
    let settled = false;
    let visible = true;

    const build = () => {
      width = figure.clientWidth;
      height = figure.clientHeight;
      pad = width * PAD;
      if (!width || !height || !img.naturalWidth) return;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * (1 + PAD * 2) * dpr);
      canvas.height = Math.round(canvas.clientHeight * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Erasing the top of the drawn region completes the handoff from the
      // image, and erasing the bottom keeps the resting fade into the page.
      fade = ctx.createLinearGradient(0, height * ZONE_TOP, 0, height);
      fade.addColorStop(0, "rgba(0,0,0,1)");
      fade.addColorStop(HANDOFF / (1 - ZONE_TOP), "rgba(0,0,0,0)");
      fade.addColorStop(0.38, "rgba(0,0,0,0.5)");
      fade.addColorStop(0.74, "rgba(0,0,0,0.85)");
      fade.addColorStop(1, "rgba(0,0,0,1)");

      const source = document.createElement("canvas");
      source.width = img.naturalWidth;
      source.height = img.naturalHeight;
      const sourceCtx = source.getContext("2d", { willReadFrequently: true });
      if (!sourceCtx) return;
      sourceCtx.drawImage(img, 0, 0);
      const { data } = sourceCtx.getImageData(0, 0, source.width, source.height);

      const scaleX = source.width / width;
      const scaleY = source.height / height;
      const next: Cell[] = [];

      // Only the band the front can ever reach needs grains.
      for (let y = height * (PEAK_FRONT - FEATHER); y < height; y += CELL) {
        for (let x = 0; x < width; x += CELL) {
          // Average the source pixels this grain covers so a released mote
          // carries the colour of what it came from.
          let sum = 0;
          let alpha = 0;
          let count = 0;
          const sx0 = Math.floor(x * scaleX);
          const sy0 = Math.floor(y * scaleY);
          const sx1 = Math.min(Math.ceil((x + CELL) * scaleX), source.width);
          const sy1 = Math.min(Math.ceil((y + CELL) * scaleY), source.height);
          for (let sy = sy0; sy < sy1; sy++) {
            for (let sx = sx0; sx < sx1; sx++) {
              const i = (sy * source.width + sx) * 4;
              sum += 0.299 * data[i] + 0.587 * data[i + 1] + 0.114 * data[i + 2];
              alpha += data[i + 3];
              count++;
            }
          }
          if (!count) continue;

          const a = alpha / count / 255;
          if (a < 0.05) continue;

          next.push({
            x: x + pad,
            y,
            v: sum / count,
            a,
            nx: x / GRAIN,
            ny: y / GRAIN,
          });
        }
      }

      cells = next;
      gone = new Uint8Array(cells.length);
      settled = false;
    };

    const release = (cell: Cell, haste: number) => {
      if (motes.length >= MOTE_LIMIT) return;
      motes.push({
        x: cell.x,
        y: cell.y,
        vx: (Math.random() - 0.5) * 6,
        vy: (8 + Math.random() * 14) * haste,
        v: cell.v,
        // Motes ignore the resting fade, so ash stays legible as it falls
        // through the part of the figure that has already gone soft.
        a: cell.a * 0.75,
        age: 0,
      });
    };

    const draw = (now: number) => {
      frame = requestAnimationFrame(draw);
      const dt = Math.min((now - previous) / 1000, 0.05);
      previous = now;
      if (!visible || !cells.length || !fade) return;
      elapsed += dt;

      // The easter egg: sit on the page long enough and the front starts
      // climbing, faster as it goes.
      const progress = clamp((elapsed - PATIENCE) / CLIMB);
      const eased = progress * progress;
      const front = height * (REST_FRONT - (REST_FRONT - PEAK_FRONT) * eased);
      const reach = height * FEATHER;
      const haste = 1 + eased * 1.5;
      const seconds = elapsed * haste;

      ctx.clearRect(0, 0, canvas.clientWidth, canvas.clientHeight);
      ctx.drawImage(
        img,
        0,
        img.naturalHeight * ZONE_TOP,
        img.naturalWidth,
        img.naturalHeight * (1 - ZONE_TOP),
        pad,
        height * ZONE_TOP,
        width,
        height * (1 - ZONE_TOP),
      );

      // Coarse field decides where the front bulges, fine field breaks its edge
      // into individual grains. Their drifts share no common period.
      const coarseX = seconds * 0.013;
      const coarseY = seconds * -0.021;
      const fineX = seconds * -0.037;
      const fineY = seconds * 0.029;

      ctx.globalCompositeOperation = "destination-out";
      ctx.fillStyle = fade;
      ctx.fillRect(pad, height * ZONE_TOP, width, height * (1 - ZONE_TOP));

      ctx.fillStyle = "#000";
      for (let i = 0; i < cells.length; i++) {
        const cell = cells[i];
        const depth = (cell.y - front) / reach;
        if (depth < -0.7) continue;

        const field =
          noise(cell.nx * 0.34 + coarseX, cell.ny * 0.34 + coarseY) * 0.55 +
          noise(cell.nx + fineX, cell.ny + fineY) * 0.45;
        const eaten = clamp(depth + (field - 0.5) * 1.4);
        if (eaten < 0.03) {
          gone[i] = 0;
          continue;
        }

        if (!gone[i] && eaten > 0.5) {
          // Whatever the field has already eaten when the page opens is adopted
          // silently. Only grains that go afterwards release a mote.
          if (settled) release(cell, haste);
          gone[i] = 1;
        }

        ctx.globalAlpha = eaten;
        ctx.fillRect(cell.x, cell.y, CELL, CELL);
      }

      settled = true;

      ctx.globalCompositeOperation = "source-over";
      for (let i = motes.length - 1; i >= 0; i--) {
        const mote = motes[i];
        mote.age += dt;
        if (mote.age >= LIFE) {
          motes.splice(i, 1);
          continue;
        }
        mote.vy += 2 * dt;
        mote.x += mote.vx * dt;
        mote.y += mote.vy * dt;

        ctx.fillStyle = grays[Math.min(mote.v >> 2, 63)];
        ctx.globalAlpha = mote.a * Math.pow(1 - mote.age / LIFE, 1.4);
        ctx.fillRect(mote.x, mote.y, CELL, CELL);
      }

      ctx.globalAlpha = 1;
    };

    const start = () => {
      build();
      if (!cells.length) return;
      figure.dataset.dissolve = "on";
      previous = performance.now();
      frame = requestAnimationFrame(draw);
    };

    const resize = new ResizeObserver(() => {
      if (!cells.length) return;
      motes.length = 0;
      build();
    });
    resize.observe(figure);

    const observer = new IntersectionObserver(entries => {
      visible = entries[entries.length - 1].isIntersecting;
    });
    observer.observe(figure);

    const onVisibility = () => {
      visible = !document.hidden;
    };
    document.addEventListener("visibilitychange", onVisibility);

    if (img.complete) start();
    else img.addEventListener("load", start, { once: true });

    teardown = () => {
      cancelAnimationFrame(frame);
      resize.disconnect();
      observer.disconnect();
      document.removeEventListener("visibilitychange", onVisibility);
      delete figure.dataset.dissolve;
    };
  });
</script>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
