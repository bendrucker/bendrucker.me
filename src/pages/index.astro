---
import Layout from "@/layouts/Layout.astro";
import Masthead from "@/components/home/Masthead.astro";
import WritingNote from "@/components/home/WritingNote.astro";
---

<Layout
  description="Programmer, cyclist, and photographer."
  sourcePath="src/pages/index.astro"
  headerVariant="home"
>
  <main id="main-content" data-layout="index">
    <Masthead />
    <WritingNote />
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const mainContent = document.querySelector("#main-content");
    if (mainContent instanceof HTMLElement && mainContent.dataset.layout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
