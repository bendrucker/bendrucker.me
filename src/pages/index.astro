---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Masthead from "@/components/home/Masthead.astro";
import PostList from "@/components/home/PostList.astro";
import { getSortedPosts } from "@/blog/posts";

const sorted = getSortedPosts(await getCollection("blog"));
const featured = sorted.filter(({ data }) => data.featured);
const [label, highlighted]: [string, CollectionEntry<"blog">[]] = featured.length
  ? ["Featured", featured]
  : ["Recent", sorted.slice(0, 3)];
---

<Layout
  description="Programmer, cyclist, and photographer."
  sourcePath="src/pages/index.astro"
  headerVariant="home"
>
  <main id="main-content" data-layout="index">
    <Masthead />
    <PostList {label} posts={highlighted} />
  </main>
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
