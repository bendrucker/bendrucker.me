---
import Layout from "@/layouts/Layout.astro";
import HomeCard from "@/components/parts/HomeCard.vue";
import ItemRow from "@/components/parts/ItemRow.vue";
import { KIND_ICONS } from "@/components/parts/icons";
import PosterShelf from "@/components/media/PosterShelf.vue";
import RecordShelf from "@/components/media/RecordShelf.vue";
import { homeCredits } from "@/categories";
import { SITE } from "@/config";
import { desktopOnly } from "@/home/cards";
import { loadHome } from "@/home/load";
import { distanceFigure } from "@/rides/format";
import { rideHref } from "@/rides/links";
import { isHilly } from "@/rides/rank";

const cards = await loadHome();
const credits = homeCredits(cards.map((card) => card.id));

// Five rows ship in every card and the last two hide below the desktop
// breakpoint, since the server can't know the width it renders for.
const rowClass = (i: number) => (desktopOnly(i) ? "max-md:hidden" : undefined);
---

<Layout
  description="Programmer, cyclist, and photographer."
  credits={credits}
  sourcePath="src/pages/index.astro"
>
  <main id="main-content" class="flex-1">
    <section
      aria-label="Introduction"
      class="border-b border-line px-4 py-2.5 md:px-12 md:py-7"
    >
      <h1 class="sr-only">{SITE.title}</h1>
      <p class="text-sm leading-normal md:text-xl">
        Programmer, cyclist, and photographer in San Francisco.
      </p>
    </section>

    <div
      class="flex flex-col gap-2 px-4 pt-3 pb-6 md:gap-4 md:px-12 md:pt-7 md:pb-10"
    >
      <h2 class="label-caps text-dim md:sr-only">Lately</h2>
      <div class="grid grid-cols-1 gap-2 md:grid-cols-2 md:gap-4">
        {
          cards.map((card) => (
            <HomeCard id={card.id}>
              {card.id === "rides" && (
                <ul class="flex flex-col gap-0.5 md:gap-1">
                  {card.items.map((ride, i) => (
                    <li class={rowClass(i)}>
                      <ItemRow
                        href={rideHref(ride.id, "imperial")}
                        title={ride.name}
                        figure={distanceFigure(ride.distanceM, "imperial")}
                        hilly={isHilly(ride)}
                        compact
                      />
                    </li>
                  ))}
                </ul>
              )}
              {card.id === "code" && (
                <ul class="flex flex-col gap-0.5 md:gap-1">
                  {card.items.map((row, i) => (
                    <li class={rowClass(i)}>
                      <ItemRow
                        href={row.href}
                        title={row.title}
                        org={row.org || undefined}
                        lead={row.lead}
                        dot={row.dot}
                        compact
                      />
                    </li>
                  ))}
                </ul>
              )}
              {card.id === "reading" && (
                <ul class="flex flex-col gap-0.5 md:gap-1">
                  {card.items.map((row, i) => (
                    <li class={rowClass(i)}>
                      <ItemRow
                        href={row.url}
                        via={row.via}
                        title={row.title}
                        text={row.text}
                        note={row.note}
                        lead="kind"
                        kind={KIND_ICONS[row.type]}
                        leadLabel={row.type}
                        compact
                      />
                    </li>
                  ))}
                </ul>
              )}
              {card.id === "writing" && (
                <ul class="flex flex-col gap-0.5 md:gap-1">
                  {card.items.map((post, i) => (
                    <li class={rowClass(i)}>
                      <ItemRow href={post.href} title={post.title} compact />
                    </li>
                  ))}
                </ul>
              )}
              {card.id === "watching" && (
                <PosterShelf
                  client:visible
                  items={card.items.map((row, i) => ({
                    ...row,
                    desktopOnly: desktopOnly(i),
                  }))}
                />
              )}
              {card.id === "listening" && (
                <RecordShelf
                  client:visible
                  items={card.items.map((row, i) => ({
                    ...row,
                    desktopOnly: desktopOnly(i),
                  }))}
                />
              )}
            </HomeCard>
          ))
        }
      </div>
    </div>
  </main>
</Layout>
