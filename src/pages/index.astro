---
import Layout from "@/layouts/Layout.astro";
import Band from "@/components/about/Band.astro";
import CodeFeature from "@/components/parts/CodeFeature.vue";
import HomeCard from "@/components/parts/HomeCard.vue";
import HomeDetail from "@/components/parts/HomeDetail.vue";
import HomeItemList from "@/components/parts/HomeItemList.astro";
import RideFeature from "@/components/parts/RideFeature.vue";
import { KIND_ICONS } from "@/components/parts/icons";
import PosterShelf from "@/components/media/PosterShelf.vue";
import RecordShelf from "@/components/media/RecordShelf.vue";
import { homeCredits } from "@/categories";
import { desktopOnly, SHELF_PHONE } from "@/activity/highlights";
import { HOME_ROWS } from "@/home/cards";
import { loadHome } from "@/home/load";
import {
  HOME_PARAM,
  parseHomeKey,
  type HomeDetail as Detail,
} from "@/home/detail";
import { queryRideById } from "@/activity/feed";
import { loadCodeDetail } from "@/code/detail";
import { getDb } from "@/db";
import { rethrowLocally } from "@/fallback";
import type { OpenDetail } from "@/detail/useDetailModal";
import { RIDE_ID, toRideDetailWire } from "@/rides/detail";
import { climbFigure, distanceFigure, fullDate } from "@/rides/format";
import { rideHref } from "@/rides/links";
import { isHilly } from "@/rides/rank";

const { cards, features } = await loadHome();
const credits = homeCredits(cards.map((card) => card.id));
if (features.rides?.route) credits.push("maps");

// A shared link to an item open over the cards renders it open, as the lists
// do. A key naming nothing leaves the cards alone, and the island takes the
// parameter back out of the URL.
const openKey = Astro.url.searchParams.get(HOME_PARAM);
const openItem = openKey === null ? null : parseHomeKey(openKey);
let open: OpenDetail<Detail> | null = null;
if (openKey !== null && openItem !== null) {
  try {
    const db = await getDb();
    if (openItem.kind === "ride" && RIDE_ID.test(openItem.id)) {
      const detail = await queryRideById(db, openItem.id);
      if (detail !== null) {
        open = {
          key: openKey,
          data: { kind: "ride", ride: toRideDetailWire(detail) },
        };
      }
    } else if (openItem.kind === "code") {
      const detail = await loadCodeDetail(db, openItem.key);
      if (detail !== null) {
        open = { key: openKey, data: { kind: "code", detail } };
      }
    }
  } catch (error) {
    rethrowLocally(error, "Failed to load home detail", { key: openKey });
  }
}

const ride = features.rides;
const rideFigures = ride
  ? [
      distanceFigure(ride.ride.distanceM, "imperial"),
      climbFigure(ride.ride.climbM, "imperial"),
    ].filter((figure) => figure !== undefined)
  : [];
---

<Layout
  description="Programmer, cyclist, and photographer."
  credits={credits}
  sourcePath="src/pages/index.astro"
>
  <main id="main-content" class="flex-1">
    <Band heading />
    <section
      aria-label="Introduction"
      class="border-b border-line px-4 py-4 md:px-site md:py-7"
    >
      <div class="flex max-w-prose flex-col gap-3 text-[15px] leading-relaxed md:text-lg">
        <p>
          I'm Ben. I write software, mostly open source in Go and TypeScript,
          and I ride bikes around the Bay Area, where I'm president of the San
          Francisco Cycling Club.
        </p>
        <p class="text-dim">
          Below is what I've ridden and built lately. I used to write here too,
          and those posts are in the{" "}
          <a
            href="/writing/"
            class="text-foreground underline decoration-dashed underline-offset-4"
          >
            archive
          </a>
          .
        </p>
      </div>
    </section>

    <div class="flex flex-col gap-2 px-4 pt-3 pb-6 md:gap-4 md:px-site md:pt-7 md:pb-10">
      <h2 class="label-caps text-dim md:sr-only">Lately</h2>
      <!-- A row's cards stretch to the taller one, so the rows line up. -->
      <div class="grid grid-cols-1 gap-2 md:grid-cols-2 md:gap-4">
        {cards.map((card) => (
          <HomeCard id={card.id}>
            {card.id === "rides" && ride && (
              <RideFeature
                href={rideHref(ride.ride.id, "imperial")}
                name={ride.ride.name}
                when={fullDate(
                  ride.ride.day,
                  String(new Date().getUTCFullYear()),
                )}
                figures={rideFigures}
                hilly={isHilly(ride.ride)}
                id={ride.ride.id}
                route={ride.route}
                photos={ride.photos}
              />
            )}
            {card.id === "code" && features.code && (
              <CodeFeature
                href={features.code.row.href}
                title={features.code.row.title}
                org={features.code.row.org || undefined}
                text={features.code.row.text || undefined}
                lead={features.code.row.lead}
                dot={features.code.row.dot}
                latest={features.code.latest}
              />
            )}
            {card.id === "rides" && (
              <HomeItemList
                rows={card.items.map((ride) => ({
                  href: rideHref(ride.id, "imperial"),
                  title: ride.name,
                  figure: distanceFigure(ride.distanceM, "imperial"),
                  hilly: isHilly(ride),
                }))}
              />
            )}
            {card.id === "code" && (
              <HomeItemList
                rows={card.items.map((row) => ({
                  href: row.href,
                  title: row.title,
                  org: row.org || undefined,
                  lead: row.lead,
                  dot: row.dot,
                }))}
              />
            )}
            {card.id === "reading" && (
              <HomeItemList
                rows={card.items.map((row) => ({
                  href: row.url,
                  via: row.via,
                  title: row.title,
                  text: row.text,
                  note: row.note,
                  lead: "kind",
                  kind: KIND_ICONS[row.type],
                  leadLabel: row.type,
                }))}
              />
            )}
            {card.id === "watching" && (
              <PosterShelf
                client:visible
                layout="home"
                items={card.items.map((row, i) => ({
                  ...row,
                  desktopOnly: desktopOnly(i, SHELF_PHONE),
                  wideOnly: i >= HOME_ROWS.card,
                }))}
              />
            )}
            {card.id === "listening" && (
              <RecordShelf
                client:visible
                layout="home"
                items={card.items.map((row, i) => ({
                  ...row,
                  desktopOnly: desktopOnly(i, SHELF_PHONE),
                }))}
              />
            )}
          </HomeCard>
        ))}
      </div>
    </div>
    <HomeDetail
      client:idle
      thisYear={String(new Date().getUTCFullYear())}
      open={open}
    />
  </main>
</Layout>
