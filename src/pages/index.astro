---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/blog/posts";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
---

<Layout
  description="Programmer, cyclist, and photographer."
  sourcePath="src/pages/index.astro"
>
  <main
    id="main-content"
    data-layout="index"
    class="flex flex-1 flex-col justify-center"
  >
    <section id="hero" class="pt-8 pb-6 text-center">
      <figure class="portrait mx-auto mb-6">
        <img
          src="/images/ben-drucker-cut.png"
          alt="Ben Drucker"
          width="512"
          height="512"
        />
        <canvas class="fog" aria-hidden="true"></canvas>
      </figure>
      <p>
        <LinkButton
          href="/activity/code"
          class="underline decoration-dashed underline-offset-4"
          >Programmer</LinkButton
        >, <LinkButton
          href="https://www.strava.com/athletes/5723594"
          class="underline decoration-dashed underline-offset-4"
          >cyclist</LinkButton
        >, and photographer, living in San Francisco.
      </p>
    </section>

    {
      featuredPosts.length > 0 && (
        <>
          <section id="featured" class="pt-12 pb-6">
            <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
            <ul>
              {featuredPosts.map((data) => (
                <Card variant="h3" {...data} />
              ))}
            </ul>
          </section>
        </>
      )
    }
  </main>
</Layout>

<style>
  /* Centering puts the figure lower than it reads. Reserve space below it so
     the group settles around the upper third of the open area. */
  #main-content {
    padding-bottom: 14svh;
  }

  /* The fog spills wider than the figure to give its edges room to fade, which
     on a narrow viewport reaches past the content. */
  #hero {
    overflow-x: clip;
  }

  .portrait {
    position: relative;
    /* Larger and viewport-driven so it fills more of a phone screen, capped so
       it stays reasonable on desktop. */
    width: clamp(11rem, 55vw, 16rem);
    height: clamp(11rem, 55vw, 16rem);
    --shadow-rgb: 20, 28, 40;
    --shadow-a: 0.16;
    --sx: 0px;
    --sy: 8px;
  }

  /* The light-theme shadow is invisible on the dark backdrop (#212737), so
     darken it to black and strengthen it just enough to still read as a lift. */
  html[data-theme="dark"] .portrait {
    --shadow-rgb: 0, 0, 0;
    --shadow-a: 0.3;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1)
      drop-shadow(
        var(--sx) var(--sy) 10px rgba(var(--shadow-rgb), var(--shadow-a))
      );
    transition: filter 150ms ease-out;
    /* Fade the torso into the page background. This is the resting state for
       browsers that give us no WebGL context to fog it with instead. */
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 42%,
      rgba(0, 0, 0, 0.5) 64%,
      rgba(0, 0, 0, 0.15) 85%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 42%,
      rgba(0, 0, 0, 0.5) 64%,
      rgba(0, 0, 0, 0.15) 85%,
      transparent 100%
    );
  }

  /* The fog does the work of the fade, but it thins out at its own edges and
     can't be trusted to cover the bottom of the cutout. The image holds a late,
     shallow ramp underneath so there is never a hard cut waiting behind a gap
     in the weather. */
  .portrait[data-fog] img {
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 60%,
      rgba(0, 0, 0, 0.7) 78%,
      rgba(0, 0, 0, 0.25) 90%,
      transparent 99%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 60%,
      rgba(0, 0, 0, 0.7) 78%,
      rgba(0, 0, 0, 0.25) 90%,
      transparent 99%
    );
  }

  .fog {
    position: absolute;
    /* Rolls in around the chest and spills well past the figure on every side,
       so the bank reads as weather rather than a panel behind the portrait.
       Stops short of the caption below. */
    top: 44%;
    left: -45%;
    width: 190%;
    height: 62%;
    pointer-events: none;
    z-index: 1;
  }
</style>

<script>
  // Re-bound on every ClientRouter navigation; abort the previous binding so
  // window/document listeners don't accumulate across visits to the home page.
  let tiltController: AbortController | undefined;

  document.addEventListener("astro:page-load", () => {
    tiltController?.abort();
    tiltController = undefined;

    const portrait = document.querySelector<HTMLElement>(".portrait");
    if (
      !portrait ||
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    )
      return;

    tiltController = new AbortController();
    const { signal } = tiltController;

    const REACH = 6;
    const clamp = (n: number) => Math.max(-1, Math.min(1, n));
    const set = (sx: number, sy: number) => {
      portrait.style.setProperty("--sx", `${sx.toFixed(1)}px`);
      portrait.style.setProperty("--sy", `${(8 + sy).toFixed(1)}px`);
    };

    const onOrient = (e: DeviceOrientationEvent) => {
      if (e.gamma == null || e.beta == null) return;
      set(clamp(e.gamma / 40) * REACH, clamp((e.beta - 45) / 40) * REACH);
    };

    // Android and pre-13 iOS expose the gyroscope without a prompt. iOS 13+
    // gates it behind DeviceOrientationEvent.requestPermission(), which pops a
    // system dialog on first tap; we skip that, so those visitors keep the
    // resting shadow.
    const DOE =
      window.DeviceOrientationEvent as typeof DeviceOrientationEvent & {
        requestPermission?: () => Promise<PermissionState>;
      };
    if (DOE && typeof DOE.requestPermission !== "function") {
      window.addEventListener("deviceorientation", onOrient, { signal });
    }

    // Desktop proxy: no gyroscope, so map the cursor across the viewport to the
    // same range, with the shadow falling away from the pointer as if it were
    // the light source. Fine pointers only, to avoid fighting touch scrolling.
    if (window.matchMedia("(pointer: fine)").matches) {
      window.addEventListener(
        "pointermove",
        (e) => {
          set(
            -clamp((e.clientX / window.innerWidth) * 2 - 1) * REACH,
            -clamp((e.clientY / window.innerHeight) * 2 - 1) * REACH,
          );
        },
        { signal },
      );
    }
  });
</script>

<script>
  // A fog bank rolls across the chest and carries the rest of the figure into
  // the page. It is four planes of fractal noise stacked back to front, each
  // drifting through the 3D field at its own scale and speed, so the parallax
  // between them reads as a volume rather than a single texture. The field
  // origin is random per page load: no two visits get the same weather.
  const BAND_TOP = 0.02; // canvas-relative height where the first wisps appear
  const BAND_SOLID = 0.82; // and where the fog has taken everything
  const SHEER = 0.32; // most the fog can hide where it first meets the chest
  const VEIL = 0.2; // peak opacity of the faint haze hanging behind the bank
  const FRONT = 0.2; // peak opacity of the streaks crossing in front of it
  const DPR_CAP = 1.5; // the field is soft, so full retina buys nothing
  const SPAN = 3.0; // noise cells down the canvas; fewer means larger shapes

  const VERTEX = `
    attribute vec2 aPos;
    varying vec2 vUv;
    void main() {
      vUv = vec2(aPos.x * 0.5 + 0.5, 0.5 - aPos.y * 0.5);
      gl_Position = vec4(aPos, 0.0, 1.0);
    }
  `;

  const FRAGMENT = `
    #ifdef GL_FRAGMENT_PRECISION_HIGH
      precision highp float;
    #else
      precision mediump float;
    #endif

    varying vec2 vUv;
    uniform float uTime;
    uniform vec3 uOrigin;
    uniform vec2 uScale;
    uniform vec2 uBand;
    uniform float uSheer;
    uniform float uVeil;
    uniform float uFront;
    uniform vec3 uFore;
    uniform vec3 uPage;

    float hash(vec3 p) {
      p = fract(p * 0.1031);
      p += dot(p, p.zyx + 31.32);
      return fract((p.x + p.y) * p.z);
    }

    float noise(vec3 x) {
      vec3 i = floor(x);
      vec3 f = x - i;
      f = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(
          mix(hash(i), hash(i + vec3(1.0, 0.0, 0.0)), f.x),
          mix(hash(i + vec3(0.0, 1.0, 0.0)), hash(i + vec3(1.0, 1.0, 0.0)), f.x),
          f.y),
        mix(
          mix(hash(i + vec3(0.0, 0.0, 1.0)), hash(i + vec3(1.0, 0.0, 1.0)), f.x),
          mix(hash(i + vec3(0.0, 1.0, 1.0)), hash(i + vec3(1.0, 1.0, 1.0)), f.x),
          f.y),
        f.z);
    }

    float fbm3(vec3 p) {
      float sum = 0.0;
      float amp = 0.5;
      for (int i = 0; i < 3; i++) {
        sum += amp * noise(p);
        p = p * 2.03 + 7.1;
        amp *= 0.5;
      }
      return sum;
    }

    float fbm4(vec3 p) {
      float sum = 0.0;
      float amp = 0.5;
      for (int i = 0; i < 4; i++) {
        sum += amp * noise(p);
        p = p * 2.03 + 7.1;
        amp *= 0.5;
      }
      return sum;
    }

    void main() {
      // The cutoff sweeps down through the range of each field, so the top of
      // the band passes only the densest cores and the bottom passes all of it.
      float depth = smoothstep(uBand.x, uBand.y, vUv.y);
      vec2 ground = vUv * uScale;

      // Farthest plane: a broad slow haze too faint to have shapes of its own.
      // It hangs behind the bank and gives the shapes in front something to
      // stand out against.
      vec3 pv = vec3(ground * 0.55, uTime * 0.012) + uOrigin + vec3(11.0, 5.0, 17.0);
      pv.x += uTime * 0.006;
      float veil = fbm3(pv);
      float dVeil = smoothstep(0.3, 0.8, veil) * uVeil * smoothstep(0.05, 0.5, depth);

      // Middle plane: distinct billows drifting against the near bank, which
      // is where most of the parallax comes from.
      vec3 pm = vec3(ground * 0.95, uTime * 0.03) + uOrigin + vec3(3.0, 23.0, 7.0);
      pm.x -= uTime * 0.018;
      float mid = fbm4(pm);
      float dMid = smoothstep(0.6 - depth * 0.45, 0.95 - depth * 0.55, mid) *
        mix(0.1, 0.7, depth);

      // Near plane: the bank itself, and the only layer trusted to reach full
      // cover by the bottom of the band. Looking the field up through another
      // octave of itself curls it. Without that the pattern reads as a texture
      // being panned.
      vec3 pn = vec3(ground * 1.35, uTime * 0.055) + uOrigin + vec3(29.0, 13.0, 31.0);
      float warp = fbm3(pn * 0.5 - vec3(uTime * 0.025, 0.0, 0.0));
      vec3 curled = pn + vec3(warp * 1.5 - uTime * 0.05, warp * 0.9, 0.0);
      float cloud = fbm4(curled);
      float dNear = smoothstep(0.64 - depth * 0.62, 0.9 - depth * 0.78, cloud);

      // Sampling the same field a step higher tells us whether this point sits
      // under thicker fog than itself. Those undersides pick up extra tint, a
      // cheap stand-in for skylight that gives the billows form.
      float above = fbm4(curled - vec3(0.0, 0.35, 0.0));
      float shade = clamp((cloud - above) * 2.5, 0.0, 1.0);

      // Front plane: fine fast streaks crossing the bank. They stay sheer and
      // die out before the bottom so the page takeover underneath stays exact.
      vec3 pf = vec3(ground * 2.1, uTime * 0.07) + uOrigin + vec3(41.0, 2.0, 53.0);
      pf.x += uTime * 0.045;
      float streak = fbm3(pf);
      float dFront = smoothstep(0.48, 0.8, streak) * uFront *
        smoothstep(0.1, 0.45, depth) * (1.0 - smoothstep(0.7, 0.95, depth));

      // Thin fog carries a tint you can see against the page. Thick fog is the
      // page, which is what lets the body disappear into it. The tint step
      // from page towards text colour differs per layer, which is what keeps
      // the planes apart to the eye: the veil sits furthest from the page, the
      // near bank barely leaves it. Keying each tint to its own field rather
      // than the final alpha means the fade-out at the edges thins the fog
      // instead of discolouring it. The shaded undersides lean further into
      // the tint, fading out low in the band so they cannot stain the full
      // cover there.
      float tNear = 0.06 * (1.0 - smoothstep(0.3, 0.9, cloud)) +
        shade * 0.12 * (1.0 - smoothstep(0.55, 0.85, depth));
      vec3 toneNear = mix(uPage, uFore, tNear);

      // Premultiplied over, composited back to front. The veil and the front
      // streaks never thicken enough to go page-coloured, so their tint rises
      // with their field instead. A flat tint there reads as a panel the exact
      // shape of the canvas.
      float tVeil = 0.2 * smoothstep(0.3, 0.9, veil);
      vec3 rgb = mix(uPage, uFore, tVeil) * dVeil;
      float a = dVeil;
      float tMid = 0.09 * (1.0 - smoothstep(0.25, 0.85, mid));
      rgb = mix(uPage, uFore, tMid) * dMid + rgb * (1.0 - dMid);
      a = dMid + a * (1.0 - dMid);
      rgb = toneNear * dNear + rgb * (1.0 - dNear);
      a = dNear + a * (1.0 - dNear);
      float tFront = 0.15 * smoothstep(0.45, 0.9, streak);
      rgb = mix(uPage, uFore, tFront) * dFront + rgb * (1.0 - dFront);
      a = dFront + a * (1.0 - dFront);

      // Capping how much it can hide near the top keeps the chest behind a
      // cloud you can see through. The cap lifts as the fog deepens, so by the
      // bottom of the band the page has taken over completely.
      float cap = mix(uSheer, 1.0, depth * depth);
      float capped = min(a, cap);
      rgb *= capped / max(a, 0.0001);
      a = capped;

      // The bank has to end somewhere. Weighting the fade-out on each edge by
      // the field itself keeps that boundary from being the canvas rectangle.
      float edge = smoothstep(0.0, 0.32, vUv.x) * smoothstep(1.0, 0.68, vUv.x) *
        smoothstep(0.0, 0.2, vUv.y);
      float fade = smoothstep(0.0, 0.8, edge * (0.55 + cloud * 0.9));
      gl_FragColor = vec4(rgb * fade, a * fade);
    }
  `;

  const compile = (gl: WebGLRenderingContext, type: number, source: string) => {
    const shader = gl.createShader(type);
    if (!shader) return null;
    gl.shaderSource(shader, source);
    gl.compileShader(shader);
    if (gl.getShaderParameter(shader, gl.COMPILE_STATUS)) return shader;
    gl.deleteShader(shader);
    return null;
  };

  const link = (gl: WebGLRenderingContext) => {
    const vertex = compile(gl, gl.VERTEX_SHADER, VERTEX);
    const fragment = compile(gl, gl.FRAGMENT_SHADER, FRAGMENT);
    if (!vertex || !fragment) return null;
    const program = gl.createProgram();
    if (!program) return null;
    gl.attachShader(program, vertex);
    gl.attachShader(program, fragment);
    gl.linkProgram(program);
    gl.deleteShader(vertex);
    gl.deleteShader(fragment);
    if (gl.getProgramParameter(program, gl.LINK_STATUS)) return program;
    gl.deleteProgram(program);
    return null;
  };

  // Computed colours arrive as rgb() strings, and the shader wants the same
  // sRGB values the page is painted with.
  const channels = (value: string) =>
    (value.match(/[\d.]+/g) ?? []).slice(0, 3).map((n) => Number(n) / 255);

  let teardown: (() => void) | undefined;

  document.addEventListener("astro:page-load", () => {
    teardown?.();
    teardown = undefined;

    const figure = document.querySelector<HTMLElement>(".portrait");
    const canvas = figure?.querySelector<HTMLCanvasElement>("canvas.fog");
    if (!figure || !canvas) return;

    const gl = canvas.getContext("webgl", {
      alpha: true,
      antialias: false,
      depth: false,
      premultipliedAlpha: true,
    });
    if (!gl) return;

    const program = link(gl);
    if (!program) return;

    const buffer = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
    // One oversized triangle covers the clip volume with no seam down the
    // middle for the noise to catch on.
    gl.bufferData(
      gl.ARRAY_BUFFER,
      new Float32Array([-1, -1, 3, -1, -1, 3]),
      gl.STATIC_DRAW,
    );
    const position = gl.getAttribLocation(program, "aPos");
    gl.enableVertexAttribArray(position);
    gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);

    gl.useProgram(program);
    gl.enable(gl.BLEND);
    gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

    const uTime = gl.getUniformLocation(program, "uTime");
    const uOrigin = gl.getUniformLocation(program, "uOrigin");
    const uScale = gl.getUniformLocation(program, "uScale");
    const uFore = gl.getUniformLocation(program, "uFore");
    const uPage = gl.getUniformLocation(program, "uPage");

    gl.uniform2f(gl.getUniformLocation(program, "uBand"), BAND_TOP, BAND_SOLID);
    gl.uniform1f(gl.getUniformLocation(program, "uSheer"), SHEER);
    gl.uniform1f(gl.getUniformLocation(program, "uVeil"), VEIL);
    gl.uniform1f(gl.getUniformLocation(program, "uFront"), FRONT);
    gl.uniform3f(
      uOrigin,
      Math.random() * 64,
      Math.random() * 64,
      Math.random() * 64,
    );

    const paint = () => {
      const style = getComputedStyle(document.body);
      const page = channels(style.backgroundColor);
      const foreground = channels(style.color);
      if (page.length < 3 || foreground.length < 3) return;
      gl.uniform3f(uPage, page[0], page[1], page[2]);
      gl.uniform3f(uFore, foreground[0], foreground[1], foreground[2]);
    };

    const measure = () => {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      if (!width || !height) return false;
      const dpr = Math.min(window.devicePixelRatio || 1, DPR_CAP);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      gl.viewport(0, 0, canvas.width, canvas.height);
      // Banks are wider than they are tall, so the field is stretched across
      // rather than sampled square.
      gl.uniform2f(uScale, (SPAN * width) / height / 1.7, SPAN);
      return true;
    };

    let frame = 0;
    let previous = 0;
    let elapsed = 0;
    let visible = true;

    const render = () => {
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform1f(uTime, elapsed);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };

    const draw = (now: number) => {
      frame = requestAnimationFrame(draw);
      const dt = Math.min((now - previous) / 1000, 0.05);
      previous = now;
      if (!visible) return;
      elapsed += dt;
      render();
    };

    const still = window.matchMedia("(prefers-reduced-motion: reduce)");

    const resize = new ResizeObserver(() => {
      if (!measure()) return;
      if (still.matches) render();
    });
    resize.observe(canvas);

    const observer = new IntersectionObserver((entries) => {
      visible = entries[entries.length - 1].isIntersecting;
    });
    observer.observe(figure);

    const onVisibility = () => {
      visible = !document.hidden;
    };
    document.addEventListener("visibilitychange", onVisibility);

    // The theme toggle swaps the page colour out from under the fog.
    const theme = new MutationObserver(() => {
      paint();
      if (still.matches) render();
    });
    theme.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme", "class"],
    });

    paint();
    if (!measure()) return;
    figure.dataset.fog = "on";

    // Reduced motion still gets fog, just a photograph of it.
    if (still.matches) render();
    else {
      previous = performance.now();
      frame = requestAnimationFrame(draw);
    }

    teardown = () => {
      cancelAnimationFrame(frame);
      resize.disconnect();
      observer.disconnect();
      theme.disconnect();
      document.removeEventListener("visibilitychange", onVisibility);
      gl.deleteProgram(program);
      gl.deleteBuffer(buffer);
      delete figure.dataset.fog;
    };
  });
</script>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
