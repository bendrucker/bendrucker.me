---
import Layout from "../../../layouts/Layout.astro";
import Main from "../../../layouts/Main.astro";
import { SITE } from "../../../config";
import YearActivity from "../../../components/activity/YearActivity.vue";
import type { Repo, YearCount } from "@/activity/types";
import { getDb } from "@/db";
import { queryYearRepos, queryYearsByLastActivity } from "@/activity/query";
import { rethrowLocally } from "@/fallback";

const year = Number(Astro.params.year);
const db = await getDb();

let initialRepos: Repo[] = [];
let initialTotal = 0;
let years: YearCount[] = [];

try {
  const result = await queryYearRepos(db, year);

  if (!result.found) {
    return Astro.redirect("/404");
  }

  initialRepos = result.repos;
  initialTotal = result.total;

  const { years: yearRows } = await queryYearsByLastActivity(db);
  years = yearRows;
} catch (error) {
  rethrowLocally(error, "Failed to load year activity data", { year });
}

const title = `Code: ${year} | ${SITE.title}`;
const description = `${initialTotal} repositories ${SITE.author} last contributed to in ${year}.`;
---

<Layout
  title={title}
  description={description}
  ogImage="/activity/code/og.png"
  sourcePath="src/pages/activity/code/[year].astro"
>
  <Main
    pageTitle={`Code (${year})`}
    pageDesc={`Repositories last contributed to in ${year}.`}
  >
    <section class="page-column">
      <YearActivity
        client:load
        initialRepos={initialRepos}
        initialTotal={initialTotal}
        year={year}
        years={years}
        username={SITE.githubUsername}
      />
    </section>
  </Main>
</Layout>
