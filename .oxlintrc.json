{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue", "unicorn", "oxc", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": [
    "dist/**",
    ".histoire/**",
    ".worktrees/**",
    "tmp/**",
    ".astro",
    "**/worker-configuration.d.ts"
  ],
  // Only rules the categories above don't already enable, plus rules that need
  // options a category can't supply.
  "rules": {
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "max-depth": "error",
    "no-array-constructor": "error",
    "no-console": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@workspace/*/src",
              "@workspace/*/src/*",
              "**/packages/*/src/*"
            ],
            "message": "Import the package entry point. Packages are consumed from dist/, not src/."
          }
        ]
      }
    ],
    "no-template-curly-in-string": "warn",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_exhaustive", "__typename", "__raw", "__dirname"]
      }
    ],
    "no-unused-expressions": [
      "error",
      {
        "allowTernary": true
      }
    ],
    "no-unused-vars": [
      "error",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "prefer-template": "error",
    "oxc/no-accumulating-spread": "error",
    // Asynchronous work is written with `await`. `strict` extends the ban past
    // the first `await`, so `await fetch(url).then(read)` is caught too.
    "promise/prefer-await-to-then": [
      "error",
      {
        "strict": true
      }
    ],
    // The executor form exists to wrap a callback API, and the ones this
    // codebase calls have promise forms already: `node:timers/promises` for a
    // delay, `Promise.withResolvers` for a deferred one. Disable inline for an
    // API that has no promise form of its own.
    "promise/avoid-new": "error",
    "unicorn/no-array-callback-reference": "error",
    "unicorn/prefer-array-find": "error",
    "unicorn/prefer-set-has": "error",
    "unicorn/prefer-structured-clone": "error",
    "typescript/ban-ts-comment": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-unsafe-function-type": "error",
    // Type-aware from here down: `npm run lint` misses these and
    // `npm run lint:types` is what catches them.
    //
    // Parse external data with a zod schema and infer the type from it rather
    // than asserting the shape.
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-floating-promises": "error",
    // The other half of `no-floating-promises`: a promise handed to a caller
    // that expects `void` is dropped just as silently. Where that is deliberate,
    // `void` the call, which both rules read as the intent it is.
    "typescript/no-misused-promises": "error",
    // A function that returns a promise says `async`, so a throw before its
    // first `await` reaches the caller as a rejection rather than as a
    // synchronous exception their `try` around `await` never sees.
    "typescript/promise-function-async": "error",
    // `return promise` inside a `try` leaves the block before the promise
    // settles, so the `catch` never sees its rejection. The default
    // `in-try-catch` mode asks for the `await` there and drops it elsewhere.
    "typescript/return-await": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/no-implied-eval": "error",
    // `never` reaches a template only through the `_exhaustive` guard on a
    // switch default, where interpolating the unhandled value is the message.
    "typescript/restrict-template-expressions": [
      "error",
      {
        "allowNever": true
      }
    ],
    // Off until `noUncheckedIndexedAccess` is on. Every assertion it flags is a
    // `!` on an index access, unnecessary only because the compiler types
    // `items[i]` as `T` rather than `T | undefined`. Stripping them now means
    // writing them back when that flag lands.
    "typescript/no-unnecessary-type-assertion": "off"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts", "**/*.vue"],
      "rules": {
        "constructor-super": "off",
        "getter-return": "off",
        "no-class-assign": "off",
        "no-const-assign": "off",
        "no-dupe-class-members": "off",
        "no-dupe-keys": "off",
        "no-func-assign": "off",
        "no-import-assign": "off",
        "no-new-native-nonconstructor": "off",
        "no-obj-calls": "off",
        "no-redeclare": "off",
        "no-setter-return": "off",
        "no-this-before-super": "off",
        "no-unreachable": "off",
        "no-unsafe-negation": "off",
        "no-with": "off"
      }
    },
    {
      // Scripts are their own entrypoint. A worker rejects top-level await in
      // the global scope, and a .vue script block that uses it turns the
      // component async, so the rule stays off everywhere else.
      "files": ["scripts/**"],
      "rules": {
        "unicorn/prefer-top-level-await": "error"
      }
    },
    {
      // Fixtures assert partial shapes of types too large to build whole.
      "files": ["**/*.test.ts", "**/fixtures.ts", "**/*.story.vue"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ]
}
